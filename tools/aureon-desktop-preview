        ("existing desktop session root", result.session_root),
        ("existing desktop overlay", result.overlay),
        ("existing desktop serial log", result.serial_log),
    ):
        _require_inside(candidate, root, label)
    return result


def _relative(path: Path, root: Path) -> str:
    """Render only stable, repository-relative evidence paths."""

    return _require_inside(path, root, "evidence path").relative_to(root).as_posix()


def _hash_file(path: Path) -> str:
    """Hash one ordinary file without following an output symlink."""

    if path.is_symlink() or not path.is_file():
        raise PreviewError("expected a regular non-link file: '{0}'".format(path))
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _source_digest(root: Path) -> tuple[list[dict[str, str]], str]:
    """Hash exactly the desktop definition and this launcher for provenance."""

    sources = (root / "system" / "desktop", root / "tools" / PROGRAM)
    records: list[dict[str, str]] = []
    for source in sources:
        lexical = _require_inside(source, root, "desktop source")
        link = _first_link(lexical, root)
        if link is not None:
            raise PreviewError("desktop source traverses symlink '{0}'".format(link))
        if lexical.is_file():
            files = (lexical,)
        elif lexical.is_dir():
            files = tuple(
                sorted(
                    (
                        item
                        for item in lexical.rglob("*")
                        if item.is_file()
                        and "__pycache__" not in item.parts
                        and item.suffix not in {".pyc", ".pyo"}
                    ),
                    key=str,
                )
            )
        else:
            raise PreviewError("desktop source is missing: '{0}'".format(lexical))
        for item in files:
            item = _require_inside(item, root, "desktop source")
            if item.is_symlink() or not item.is_file():
                raise PreviewError("desktop source must be a regular file: '{0}'".format(item))
            records.append({"path": item.relative_to(root).as_posix(), "sha256": _hash_file(item)})
    records.sort(key=lambda record: record["path"])
    encoded = json.dumps(records, ensure_ascii=True, sort_keys=True, separators=(",", ":")).encode("ascii")
    return records, hashlib.sha256(encoded).hexdigest()


def create_plan(
    build_id: str,
    boot_timeout: int,
    acceleration: str,
    repository_root: Path = ROOT,
    video: str = DEFAULT_VIDEO_ADAPTER,
    gtk_backend: str = DEFAULT_GTK_BACKEND,
) -> dict:
    """Create the deterministic no-write preview plan shown by default."""

    if acceleration not in {"auto", "kvm", "tcg"}:
        raise PreviewError("--accel must be auto, kvm, or tcg")
    if video not in {"virtio", "std"}:
        raise PreviewError("--video must be virtio or std")
    if gtk_backend not in {"auto", "x11", "wayland"}:
        raise PreviewError("--gtk-backend must be auto, x11, or wayland")
    if not MINIMUM_BOOT_TIMEOUT <= boot_timeout <= MAXIMUM_BOOT_TIMEOUT:
        raise PreviewError(
            "--boot-timeout-seconds must be between {0} and {1}".format(
                MINIMUM_BOOT_TIMEOUT, MAXIMUM_BOOT_TIMEOUT
            )
        )
    root = Path(repository_root).resolve()
    paths = preview_paths(build_id, root)
    records, digest = _source_digest(root)
    return {
        "schema": "aureon.desktop-preview-plan",
        "version": 1,
        "command": "desktop-preview",
        "build_id": build_id,
        "inputs": {
            "base_image": BASE_REFERENCE,
            "image_builder": IMAGE_BUILDER_REFERENCE,
            "source_algorithm": "sha256",
            "source_digest": digest,
            "source_files": records,
        },
        "execution": {
            "mode": "dry-run",
            "allow_build_network_required": True,
            "guest_network": "disabled",
            "boot_timeout_seconds": boot_timeout,
            "acceleration_policy": acceleration,
            "memory_mib": DEFAULT_MEMORY_MIB,
            "vcpus": DEFAULT_VCPUS,
            "video_adapter": video,
            "gtk_backend": gtk_backend,
            "requested_display": {
                "width": DEFAULT_DISPLAY_WIDTH,
                "height": DEFAULT_DISPLAY_HEIGHT,
                "refresh_hz": DEFAULT_DISPLAY_REFRESH_HZ,
                "scale": 1.0,
            },
            "virtual_disk_size_bytes": DESKTOP_IMAGE_SIZE_BYTES,
        },
        "safety": {
            "host_disk_paths_accepted": False,
            "host_directories_shared_with_guest": False,
            "physical_usb_passthrough": False,
            "windows_install_or_boot_changes": False,
        },
        "paths": {
            "manifest": _relative(paths.manifest, root),
            "result": _relative(paths.result, root),
            "package_inventory": _relative(paths.package_lock, root),
            "base_qcow2": _relative(paths.disk, root),
            "overlay": _relative(paths.overlay, root),
            "serial_log": _relative(paths.serial_log, root),
            "qemu_log": _relative(paths.qemu_log, root),
            "framebuffer_probe": _relative(paths.framebuffer_probe, root),
            "framebuffer_ready": _relative(paths.framebuffer_ready, root),
            "framebuffer_evidence": _relative(paths.framebuffer_evidence, root),
            "preview_evidence": _relative(paths.preview_evidence, root),
        },
    }


def _write_json_once(path: Path, payload: dict) -> None:
    """Preserve evidence and never overwrite a prior run."""

    try:
        with path.open("x", encoding="utf-8", newline="\n") as handle:
            json.dump(payload, handle, ensure_ascii=True, indent=2, sort_keys=True)
            handle.write("\n")
    except FileExistsError as error:
        raise PreviewError("refusing to overwrite evidence '{0}'".format(path)) from error


def _package_inventory(raw: str) -> dict:
    """Normalize an RPM NEVRA snapshot into deterministic build evidence."""

    component_pattern = re.compile(r"[A-Za-z0-9][A-Za-z0-9._+~^-]{0,255}")
    legacy_pattern = re.compile(r"[A-Za-z0-9][A-Za-z0-9._+~^:-]{1,511}")
    missing_values = {"", "(none)", "(null)", "none", "null"}
    packages: set[str] = set()
    for line_number, raw_line in enumerate(raw.splitlines(), start=1):
        line = raw_line.strip()
        if not line:
            continue
        fields = line.split("\t")
        if len(fields) == 5:
            name, epoch, version, release, architecture = (field.strip() for field in fields)
            if epoch.lower() in missing_values:
                epoch = "0"
            # RPM's synthetic gpg-pubkey records commonly report ARCH as
            # ``(none)``. Keep the record deterministic without pretending it
            # is a binary package for a real architecture.
            if architecture.lower() in missing_values:
                architecture = "none"
            if version.lower() in missing_values:
                version = "none"
            if release.lower() in missing_values:
                release = "none"
            components = (name, version, release, architecture)
            if not epoch.isdigit() or any(not component_pattern.fullmatch(value) for value in components):
                raise PreviewError(
                    "desktop OCI returned an invalid RPM package inventory at line "
                    f"{line_number}: {line[:160]!r}"
                )
            packages.add(f"{name}-{epoch}:{version}-{release}.{architecture}")
        elif legacy_pattern.fullmatch(line):
            packages.add(line)
        else:
            raise PreviewError(
                "desktop OCI returned an invalid RPM package inventory at line "
                f"{line_number}: {line[:160]!r}"
            )
    packages = sorted(packages)
    if not packages:
        raise PreviewError("desktop OCI returned an invalid RPM package inventory")
    encoded = ("\n".join(packages) + "\n").encode("utf-8")
    return {
        "algorithm": "sha256",
        "count": len(packages),
        "digest": hashlib.sha256(encoded).hexdigest(),
        "packages": packages,
    }


def _environment() -> dict[str, str]:
    """Use a minimal process environment for Podman and image tools."""

    return {"HOME": "/root", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}


def _trusted_executable(path: str, label: str) -> str:
    """Accept a system executable only, never a checkout or Windows-mounted file."""

    candidate = Path(path)
    try:
        resolved = candidate.resolve(strict=True)
    except OSError as error:
        raise PreviewError("{0} is unavailable: {1}".format(label, error)) from error
    if str(resolved).startswith("/mnt/") or ROOT == resolved or ROOT in resolved.parents:
        raise PreviewError("{0} must not be loaded from the checkout or a Windows mount".format(label))
    if not resolved.is_file() or not os.access(resolved, os.X_OK):
        raise PreviewError("{0} is not an executable regular file".format(label))
    return str(resolved)


def _capture(argv: tuple[str, ...], environment: dict[str, str], timeout: int = 60) -> str:
    """Run a reviewed argv-only command and return standard output."""

    try:
        result = subprocess.run(
            argv,
            cwd="/",
            env=environment,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise PreviewError("could not complete {0}: {1}".format(argv[0], error)) from error
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip().replace("\n", " ")
        raise PreviewError("command failed ({0}): {1}".format(result.returncode, detail[:240]))
    return result.stdout or ""


def _terminate_group(process: subprocess.Popen) -> None:
    """Stop only the child process group started by this launcher."""

    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=15)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=15)
    except subprocess.TimeoutExpired as error:
        raise PreviewError("could not stop the launcher-owned process group") from error


def _run_logged(
    argv: tuple[str, ...],
    log_path: Path,
    environment: dict[str, str],
    timeout: int | None,
    preexec_fn=None,
) -> dict:
    """Run one command without a shell while keeping a new combined log."""

    started = time.monotonic()
    try:
        with log_path.open("xb") as handle:
            process = subprocess.Popen(
                argv,
                cwd="/",
                env=environment,
                stdout=handle,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                preexec_fn=preexec_fn,
            )
            try:
                returncode = process.wait(timeout=timeout)
            except subprocess.TimeoutExpired as error:
                _terminate_group(process)
                raise PreviewError("command timed out: {0}".format(argv[0])) from error
    except FileExistsError as error:
        raise PreviewError("refusing to overwrite log '{0}'".format(log_path)) from error
    except OSError as error:
        raise PreviewError("could not start {0}: {1}".format(argv[0], error)) from error
    if returncode != 0:
        raise PreviewError("command exited {0}; inspect '{1}'".format(returncode, log_path))
    return {"returncode": returncode, "duration_seconds": round(time.monotonic() - started, 3)}


def _require_real_system_path(path: Path, label: str, directory: bool) -> None:
    """Reject symlinked, unsafe, or unexpected privileged WSL dependencies."""

    if not path.is_absolute():
        raise PreviewError("{0} must be an absolute WSL path".format(label))
    current = Path(path.anchor)
    for part in path.parts[1:]:
        current /= part
        try:
            mode = current.lstat().st_mode
        except FileNotFoundError as error:
            raise PreviewError("{0} is missing: '{1}'".format(label, current)) from error
        if stat.S_ISLNK(mode):
            raise PreviewError("{0} must not traverse symlink '{1}'".format(label, current))
    info = path.stat()
    if directory and not stat.S_ISDIR(info.st_mode):
        raise PreviewError("{0} is not a directory".format(label))
    if not directory and not stat.S_ISREG(info.st_mode):
        raise PreviewError("{0} is not a regular file".format(label))
    if info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise PreviewError("{0} must be root-owned and not group/world writable".format(label))


def _preview_identity() -> tuple[int, int, str, str, tuple[int, ...]]:
    """Return the unprivileged WSL identity that will own the visible QEMU."""

    try:
        import pwd

        uid = int(os.environ["SUDO_UID"])
        gid = int(os.environ["SUDO_GID"])
        user = os.environ["SUDO_USER"]
        entry = pwd.getpwnam(user)
    except (ImportError, KeyError, ValueError, KeyError) as error:
        raise PreviewError(
            "run --execute through 'sudo -E' from your normal WSL user so the visible QEMU window is not root-owned"
        ) from error
    if uid <= 0 or gid < 0 or entry.pw_uid != uid:
        raise PreviewError("could not validate the invoking unprivileged WSL user")
    groups = tuple(sorted(set(os.getgrouplist(user, gid))))
    return uid, gid, user, entry.pw_dir, groups


def _identity_can_access_device(path: Path, identity: tuple[int, int, str, str, tuple[int, ...]]) -> bool:
    """Check device read/write bits for the unprivileged QEMU identity."""

    try:
        device = path.stat()
    except OSError:
        return False
    if not stat.S_ISCHR(device.st_mode):
        return False
    uid, gid, _, _, groups = identity
    if uid == device.st_uid:
        readable, writable = stat.S_IRUSR, stat.S_IWUSR
    elif device.st_gid == gid or device.st_gid in groups:
        readable, writable = stat.S_IRGRP, stat.S_IWGRP
    else:
        readable, writable = stat.S_IROTH, stat.S_IWOTH
    return bool(device.st_mode & readable) and bool(device.st_mode & writable)


def _ensure_dedicated_runroot() -> None:
    """Create only the documented ephemeral Podman runroot after a WSL reboot."""

    if PODMAN_RUNROOT.exists():
        _require_real_system_path(PODMAN_RUNROOT, "dedicated Podman runroot", True)
        return
    _require_real_system_path(PODMAN_RUNROOT.parent, "WSL runtime directory", True)
    try:
        PODMAN_RUNROOT.mkdir(mode=0o700)
    except OSError as error:
        raise PreviewError("could not create the dedicated WSL Podman runroot: {0}".format(error)) from error
    _require_real_system_path(PODMAN_RUNROOT, "dedicated Podman runroot", True)


def _gui_environment(home: str, gtk_backend: str) -> dict[str, str]:
    """Pass only WSLg display variables to the unprivileged QEMU frontend."""

    required = ("DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "XAUTHORITY")
    supplied = {key: os.environ[key] for key in required if os.environ.get(key)}
    if not supplied.get("DISPLAY") and not supplied.get("WAYLAND_DISPLAY"):
        raise PreviewError("WSLg display variables are unavailable; run this from your normal Ubuntu WSL session")
    if gtk_backend not in {"auto", "x11", "wayland"}:
        raise PreviewError("--gtk-backend must be auto, x11, or wayland")
    if gtk_backend == "x11" and not supplied.get("DISPLAY"):
        raise PreviewError("the x11 GTK backend was requested but WSLg DISPLAY is unavailable")
    if gtk_backend == "wayland" and not supplied.get("WAYLAND_DISPLAY"):
        raise PreviewError("the Wayland GTK backend was requested but WSLg WAYLAND_DISPLAY is unavailable")
    environment = {"HOME": home, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PATH": "/usr/bin:/bin"}
    environment.update(supplied)
    if gtk_backend != "auto":
        environment["GDK_BACKEND"] = gtk_backend
    return environment


def _qemu_preexec(uid: int, gid: int, groups: tuple[int, ...]):
    """Create a child-only privilege drop for QEMU's GTK window."""

    def drop_privileges() -> None:
        os.setgroups(list(groups))
        os.setgid(gid)
        os.setuid(uid)

    return drop_privileges


def _validate_runtime_preflight(root: Path, acceleration: str, gtk_backend: str = DEFAULT_GTK_BACKEND) -> dict:
    """Inspect the WSL/QEMU prerequisites shared by build and resume paths."""

    if platform.system().lower() != "linux":
        raise PreviewError("desktop preview executes only inside Ubuntu WSL, never directly from Windows")
    if "microsoft" not in Path("/proc/sys/kernel/osrelease").read_text(encoding="utf-8", errors="ignore").lower():
        raise PreviewError("desktop preview is restricted to WSL so it cannot run against a native Linux host disk")
    geteuid = getattr(os, "geteuid", None)
    if geteuid is None or geteuid() != 0:
        raise PreviewError("desktop preview requires root inside WSL only; it never elevates Windows")
    if root.is_symlink() or not root.is_dir():
        raise PreviewError("checkout root must be a real directory")
    for path, label, directory in ((OVMF_CODE, "OVMF code", False), (OVMF_VARS, "OVMF variables", False)):
        _require_real_system_path(path, label, directory)
    executables = {
        "qemu": _trusted_executable("/usr/bin/qemu-system-x86_64", "QEMU"),
        "qemu_img": _trusted_executable("/usr/bin/qemu-img", "qemu-img"),
    }
    environment = _environment()
    displays = _capture((executables["qemu"], "-display", "help"), environment, 30)
    if "gtk" not in displays.split():
        raise PreviewError("QEMU GTK display backend is missing; install qemu-system-gui inside Ubuntu WSL")
    identity = _preview_identity()
    kvm_available = _identity_can_access_device(Path("/dev/kvm"), identity)
    if acceleration == "kvm" and not kvm_available:
        raise PreviewError("KVM was requested but /dev/kvm is unavailable")
    selected_acceleration = "kvm" if acceleration == "kvm" or (acceleration == "auto" and kvm_available) else "tcg"
    gui_environment = _gui_environment(identity[3], gtk_backend)
    return {
        "executables": executables,
        "environment": environment,
        "gui_environment": gui_environment,
        "identity": identity,
        "acceleration": selected_acceleration,
        "kvm_available": kvm_available,
    }


def _validate_preflight(root: Path, acceleration: str, gtk_backend: str = DEFAULT_GTK_BACKEND) -> dict:
    """Inspect all full-build prerequisites before creating preview artifacts."""

    if shutil.disk_usage(root).free < MINIMUM_FREE_BYTES:
        raise PreviewError("at least 35 GiB free space is required; the tool will not delete old artifacts automatically")
    for path, label, directory in (
        (PODMAN_ROOT, "dedicated Podman root", True),
        (PODMAN_STORE, "dedicated Podman store", True),
        (PODMAN_CONFIG, "dedicated Podman configuration", True),
    ):
        _require_real_system_path(path, label, directory)
    _ensure_dedicated_runroot()
    source_storage = root / "packaging" / "phase0-container-storage.conf"
    source_containers = root / "packaging" / "phase0-containers.conf"
    if _hash_file(source_storage) != _hash_file(PODMAN_CONFIG / "storage.conf"):
        raise PreviewError("the dedicated WSL Podman storage.conf does not match the reviewed project file")
    if _hash_file(source_containers) != _hash_file(PODMAN_CONFIG / "containers.conf"):
        raise PreviewError("the dedicated WSL Podman containers.conf does not match the reviewed project file")
    runtime = _validate_runtime_preflight(root, acceleration, gtk_backend)
    podman = _trusted_executable("/usr/bin/podman", "Podman")
    podman_prefix = (podman, "--root", str(PODMAN_STORE), "--runroot", str(PODMAN_RUNROOT), "--storage-driver", "overlay")
    for reference, label in ((BASE_REFERENCE, "Fedora bootc base"), (IMAGE_BUILDER_REFERENCE, "Image Builder")):
        try:
            _capture(podman_prefix + ("image", "exists", reference), runtime["environment"], 30)
        except PreviewError as error:
            raise PreviewError("required local {0} is absent from the dedicated WSL store: {1}".format(label, error)) from error
    runtime["executables"] = dict(runtime["executables"])
    runtime["executables"]["podman"] = podman
    runtime["podman_prefix"] = podman_prefix
    return runtime


def _require_unused_roots(paths: PreviewPaths, root: Path) -> None:
    """Refuse prior IDs and unsafe parents instead of overwriting or cleaning."""

    for parent in (root / "build", root / "images"):
        _require_inside(parent, root, "desktop output parent")
        if not parent.is_dir() or parent.is_symlink():
            raise PreviewError("required output parent is missing or unsafe: '{0}'".format(parent))
    for parent in (root / "work", root / "work" / "qemu-desktop"):
        _require_inside(parent, root, "desktop work parent")
        if parent.exists() and (parent.is_symlink() or not parent.is_dir()):
            raise PreviewError("desktop work parent is unsafe: '{0}'".format(parent))
    for target in (paths.build_root, paths.image_root, paths.work_root):
        if target.exists() or target.is_symlink():
            raise PreviewError("refusing to overwrite existing desktop preview artifact root '{0}'".format(target))


def _create_roots(paths: PreviewPaths, plan: dict, root: Path) -> None:
    """Create just the approved new artifact roots and execution manifest."""

    _require_unused_roots(paths, root)
    try:
        (root / "work").mkdir(mode=0o700, exist_ok=True)
        (root / "work" / "qemu-desktop").mkdir(mode=0o700, exist_ok=True)
        for target in (paths.build_root, paths.image_root, paths.work_root):
            target.mkdir(mode=0o700)
        manifest = dict(plan)
        manifest["execution"] = dict(plan["execution"])
        manifest["execution"]["mode"] = "execute"
        _write_json_once(paths.manifest, manifest)
    except OSError as error:
        raise PreviewError("could not create the new desktop preview artifact roots: {0}".format(error)) from error


def _expected_converter_outputs(paths: PreviewPaths) -> None:
    """Reject surprise converter files before QEMU sees any qcow2."""

    expected = {paths.disk.name, paths.buildlog.name, paths.osbuild_manifest.name}
    observed = {entry.name for entry in paths.image_root.iterdir()}
    if observed != expected:
        raise PreviewError("converter output differs from expected files: {0}".format(sorted(observed)))
    for candidate in (paths.disk, paths.buildlog, paths.osbuild_manifest):
        if candidate.is_symlink() or not candidate.is_file():
            raise PreviewError("converter output is not a regular file: '{0}'".format(candidate))


def _inspect_qcow2(paths: PreviewPaths, qemu_img: str, environment: dict[str, str], root: Path) -> dict:
    """Prove the base disk is qcow2 and has no external backing reference."""

    _expected_converter_outputs(paths)
    try:
        details = json.loads(_capture((qemu_img, "info", "--output=json", str(paths.disk)), environment, 60))
    except json.JSONDecodeError as error:
        raise PreviewError("qemu-img returned invalid JSON") from error
    if details.get("format") != "qcow2":
        raise PreviewError("desktop converter did not produce qcow2")
    if details.get("backing-filename") or details.get("full-backing-filename"):
        raise PreviewError("base qcow2 must not reference an external backing file")
    virtual_size = details.get("virtual-size")
    if not isinstance(virtual_size, int) or virtual_size < 8 * 1024**3 or virtual_size > 32 * 1024**3:
        raise PreviewError("desktop qcow2 has an unexpected virtual size")
    integrity = _capture((qemu_img, "check", str(paths.disk)), environment, 180).strip()
    return {
        "format": "qcow2",
        "virtual_size_bytes": virtual_size,
        "integrity_check": integrity or "qemu-img check exited 0",
        "sha256": _hash_file(paths.disk),
    }


def _copy_file_exclusive(source: Path, destination: Path) -> None:
    """Create a private writable OVMF variables copy without following a link."""

    if source.is_symlink() or not source.is_file():
        raise PreviewError("OVMF variables source is not a regular file")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(destination, flags, 0o600)
    except FileExistsError as error:
        raise PreviewError("refusing to overwrite OVMF variables copy") from error
    try:
        with source.open("rb") as input_handle, os.fdopen(descriptor, "wb") as output_handle:
            shutil.copyfileobj(input_handle, output_handle, 1024 * 1024)
    except OSError as error:
        raise PreviewError("could not create OVMF variables copy: {0}".format(error)) from error
    if destination.is_symlink() or not destination.is_file():
        raise PreviewError("OVMF variables copy became unsafe")


def _transfer_work_to_user(paths: PreviewPaths, uid: int, gid: int) -> None:
    """Let only the invoking WSL user own QEMU's disposable GUI files."""

    for candidate, mode in ((paths.work_root, 0o700), (paths.vars_copy, 0o600), (paths.overlay, 0o600)):
        if candidate.is_symlink():
            raise PreviewError("desktop work artifact became a symlink: '{0}'".format(candidate))
        try:
            os.chown(candidate, uid, gid)
            os.chmod(candidate, mode)
        except OSError as error:
            raise PreviewError("could not transfer disposable QEMU artifact to the WSL user: {0}".format(error)) from error


def _make_base_readonly_for_preview(paths: PreviewPaths) -> None:
    """Allow QEMU's user to read, but never write, the root-owned base qcow2."""

    for candidate, mode in (
        (paths.image_root, 0o755),
        (paths.disk, 0o444),
        (paths.buildlog, 0o444),
        (paths.osbuild_manifest, 0o444),
    ):
        if candidate.is_symlink():
            raise PreviewError("desktop base artifact became a symlink: '{0}'".format(candidate))
        try:
            os.chmod(candidate, mode)
        except OSError as error:
            raise PreviewError("could not make desktop base artifact read-only: {0}".format(error)) from error


def _cleanup_conversion(
    podman_prefix: tuple[str, ...], cid_path: Path, cleanup_log: Path, build_id: str, environment: dict[str, str]
) -> None:
    """Stop/remove only the converter whose CID file and label prove ownership."""

    try:
        with cleanup_log.open("x", encoding="utf-8", newline="\n") as log:
            if cid_path.is_symlink() or not cid_path.is_file():
                log.write("No owned converter CID was created; no cleanup target was selected.\n")
                return
            cid = cid_path.read_text(encoding="ascii", errors="ignore").strip()
            if not re.fullmatch(r"[0-9a-f]{12,64}", cid):
                log.write("Refused cleanup: CID file was malformed.\n")
                return
            inspect = subprocess.run(
                podman_prefix + ("container", "inspect", "--format", "{{index .Config.Labels \"io.aureon.desktop.preview\"}}", cid),
                cwd="/",
                env=environment,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                check=False,
                timeout=30,
            )
            log.write(inspect.stdout or "")
            if inspect.returncode != 0 or inspect.stdout.strip() != build_id:
                log.write("Refused cleanup: converter ownership label did not match.\n")
                return
            for command in (("container", "stop", "--time", "15", cid), ("container", "rm", "--force", cid)):
                result = subprocess.run(
                    podman_prefix + command,
                    cwd="/",
                    env=environment,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    check=False,
                    timeout=45,
                )
                log.write(result.stdout or "")
    except (OSError, subprocess.TimeoutExpired) as error:
        # The stage failure remains the primary result; retain any cleanup evidence
        # that could be written and never fall back to a global container cleanup.
        try:
            with cleanup_log.open("a", encoding="utf-8") as log:
                log.write("Cleanup helper error: {0}\n".format(error))
        except OSError:
            pass


def _qmp_runtime_paths(paths: PreviewPaths | ExistingSessionPaths) -> tuple[Path, Path]:
    """Return a short private runtime path; AF_UNIX paths cannot use long DrvFS names."""

    token = hashlib.sha256(os.fspath(paths.qemu_log).encode("utf-8")).hexdigest()[:20]
    directory = QMP_RUNTIME_ROOT / token
    return directory, directory / "qmp.sock"


def _prepare_qmp_runtime(paths: PreviewPaths | ExistingSessionPaths, uid: int, gid: int) -> tuple[Path, Path]:
    """Create one launcher-owned QMP directory below volatile WSL /run."""

    if QMP_RUNTIME_ROOT.exists():
        _require_real_system_path(QMP_RUNTIME_ROOT, "Aureon QMP runtime root", True)
    else:
        _require_real_system_path(QMP_RUNTIME_ROOT.parent, "WSL runtime directory", True)
        try:
            QMP_RUNTIME_ROOT.mkdir(mode=0o755)
        except OSError as error:
            raise PreviewError("could not create the QMP runtime root: {0}".format(error)) from error
        _require_real_system_path(QMP_RUNTIME_ROOT, "Aureon QMP runtime root", True)
    try:
        # Path.mkdir applies the caller's umask.  QEMU later runs as the
        # invoking WSL user, so the reviewed root-owned parent must always be
        # traversable even when sudo inherited a restrictive umask.
        os.chmod(QMP_RUNTIME_ROOT, 0o755)
    except OSError as error:
        raise PreviewError("could not normalize the QMP runtime root: {0}".format(error)) from error
    directory, qmp_socket = _qmp_runtime_paths(paths)
    if directory.exists() or directory.is_symlink():
        raise PreviewError("refusing to reuse an existing QMP runtime directory")
    try:
        directory.mkdir(mode=0o700)
        os.chown(directory, uid, gid)
        os.chmod(directory, 0o700)
    except OSError as error:
        raise PreviewError("could not prepare the private QMP runtime: {0}".format(error)) from error
    return directory, qmp_socket


def _cleanup_qmp_runtime(directory: Path, qmp_socket: Path) -> None:
    """Remove only the exact socket and empty runtime directory created above."""

    try:
        if qmp_socket.exists() or qmp_socket.is_symlink():
            mode = qmp_socket.lstat().st_mode
            if not stat.S_ISSOCK(mode):
                return
            qmp_socket.unlink()
        directory.rmdir()
    except OSError:
        # /run is volatile.  A stale exact directory is rejected on the next
        # attempt rather than broad cleanup ever being attempted.
        return


def _qmp_reply(stream) -> dict:
    """Read a bounded QMP response while ignoring asynchronous event messages."""

    for _ in range(64):
        line = stream.readline(262145)
        if not line or len(line) > 262144:
            raise PreviewError("QMP returned an incomplete or oversized response")
        try:
            message = json.loads(line.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise PreviewError("QMP returned invalid JSON") from error
        if isinstance(message, dict) and ("return" in message or "error" in message):
            return message
    raise PreviewError("QMP did not return a bounded command response")


def _inspect_ppm(path: Path) -> dict:
    """Inspect QEMU's P6 screendump without loading any image library."""

    if path.is_symlink() or not path.is_file():
        raise PreviewError("QMP framebuffer capture is missing or unsafe")
    try:
        size = path.stat().st_size
        if size < 16 or size > 32 * 1024 * 1024:
            raise PreviewError("QMP framebuffer capture has an unexpected size")
        data = path.read_bytes()
    except OSError as error:
        raise PreviewError("QMP framebuffer capture is unreadable: {0}".format(error)) from error

    position = 0

    def token() -> bytes:
        nonlocal position
        while position < len(data):
            if data[position] == 35:  # '#'
                newline = data.find(b"\n", position)
                if newline < 0:
                    raise PreviewError("QMP PPM header has an unterminated comment")
                position = newline + 1
            elif chr(data[position]).isspace():
                position += 1
            else:
                break
        start = position
        while position < len(data) and not chr(data[position]).isspace() and data[position] != 35:
            position += 1
        if start == position:
            raise PreviewError("QMP PPM header is incomplete")
        return data[start:position]

    try:
        magic = token()
        width = int(token())
        height = int(token())
        maximum = int(token())
    except (ValueError, OverflowError) as error:
        raise PreviewError("QMP PPM header is invalid") from error
    if magic != b"P6" or maximum != 255 or width < 1 or height < 1:
        raise PreviewError("QMP framebuffer is not an 8-bit P6 image")
    if position >= len(data) or not chr(data[position]).isspace():
        raise PreviewError("QMP PPM pixel delimiter is missing")
    if data[position:position + 2] == b"\r\n":
        position += 2
    else:
        position += 1
    expected = width * height * 3
    pixels = memoryview(data)[position:]
    if len(pixels) != expected:
        raise PreviewError("QMP framebuffer pixel payload is truncated or oversized")
    pixel_count = width * height
    stride_pixels = max(1, pixel_count // 8192)
    colors: set[tuple[int, int, int]] = set()
    minimum = 255
    maximum_channel = 0
    for pixel_index in range(0, pixel_count, stride_pixels):
        offset = pixel_index * 3
        color = (pixels[offset], pixels[offset + 1], pixels[offset + 2])
        colors.add(color)
        minimum = min(minimum, *color)
        maximum_channel = max(maximum_channel, *color)
    dynamic_range = maximum_channel - minimum
    return {
        "algorithm": "sha256",
        "sha256": _hash_file(path),
        "width": width,
        "height": height,
        "sampled_unique_colors": len(colors),
        "sampled_dynamic_range": dynamic_range,
        "visually_non_uniform": len(colors) >= 8 and dynamic_range >= 16,
    }


def _qmp_screendump(qmp_socket: Path, output: Path) -> dict:
    """Capture one primary framebuffer through local QMP, never TCP."""

    if output.exists() or output.is_symlink():
        raise PreviewError("refusing to overwrite a framebuffer capture")
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection.settimeout(10.0)
    try:
        connection.connect(os.fspath(qmp_socket))
        with connection.makefile("rwb", buffering=0) as stream:
            greeting_line = stream.readline(262145)
            try:
                greeting = json.loads(greeting_line.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError) as error:
                raise PreviewError("QMP greeting is invalid") from error
            if not isinstance(greeting, dict) or "QMP" not in greeting:
                raise PreviewError("QMP greeting is missing")
            stream.write(b'{"execute":"qmp_capabilities"}\n')
            capability_reply = _qmp_reply(stream)
            if "error" in capability_reply:
                raise PreviewError("QMP rejected capability negotiation")
            request = json.dumps(
                {"execute": "screendump", "arguments": {"filename": os.fspath(output)}},
                separators=(",", ":"),
            ).encode("utf-8") + b"\n"
            stream.write(request)
            dump_reply = _qmp_reply(stream)
            if "error" in dump_reply:
                raise PreviewError("QMP screendump failed: {0}".format(str(dump_reply["error"])[:200]))
    except (OSError, socket.timeout) as error:
        raise PreviewError("QMP framebuffer capture failed: {0}".format(error)) from error
    finally:
        connection.close()
    deadline = time.monotonic() + 10
    while not output.is_file() and time.monotonic() < deadline:
        time.sleep(0.05)
    return _inspect_ppm(output)


def _capture_qmp_with_retries(qmp_socket: Path, output: Path) -> tuple[dict | None, str | None]:
    """Retry transient QMP failures without ever overwriting a capture."""

    errors: list[str] = []
    for attempt in range(QMP_CAPTURE_ATTEMPTS):
        try:
            details = _qmp_screendump(qmp_socket, output)
        except PreviewError as error:
            errors.append(str(error))
            # A created path may contain a completed or partial screendump.
            # Preserve it as evidence and never remove or overwrite it here.
            if output.exists() or output.is_symlink() or attempt + 1 == QMP_CAPTURE_ATTEMPTS:
                break
            time.sleep(0.25)
            continue
        details["path"] = output.name
        return details, None
    return None, " | ".join(errors)


def qemu_command(
    paths: PreviewPaths | ExistingSessionPaths,
    qemu: str,
    acceleration: str,
    video: str = DEFAULT_VIDEO_ADAPTER,
    qmp_socket: Path | None = None,
) -> tuple[str, ...]:
    """Return the fixed GUI VM argv; no host disk, NIC, share, or passthrough exists."""

    video_devices = {
        "virtio": "virtio-vga,edid=on,xres={0},yres={1},max_outputs=1".format(
            DEFAULT_DISPLAY_WIDTH, DEFAULT_DISPLAY_HEIGHT
        ),
        "std": "VGA,vgamem_mb=64",
    }
    if video not in video_devices:
        raise PreviewError("--video must be virtio or std")
    if qmp_socket is None:
        _, qmp_socket = _qmp_runtime_paths(paths)

    return (
        qemu,
        "-machine",
        "q35,accel={0}".format(acceleration),
        "-cpu",
        "max",
        "-smp",
        str(DEFAULT_VCPUS),
        "-m",
        str(DEFAULT_MEMORY_MIB),
        "-nodefaults",
        "-drive",
        "if=pflash,format=raw,readonly=on,file={0}".format(OVMF_CODE),
        "-drive",
        "if=pflash,format=raw,file={0}".format(paths.vars_copy),
        "-drive",
        "if=virtio,format=qcow2,file={0}".format(paths.overlay),
        "-device",
        video_devices[video],
        "-device",
        "qemu-xhci,id=xhci",
        "-device",
        "usb-kbd,bus=xhci.0",
        "-device",
        "usb-tablet,bus=xhci.0",
        "-display",
        "gtk,gl=off,zoom-to-fit=off,show-tabs=off",
        "-nic",
        "none",
        "-serial",
        "file:{0}".format(paths.serial_log),
        "-qmp",
        "unix:{0},server=on,wait=off".format(qmp_socket),
        "-monitor",
        "none",
        "-no-reboot",
    )


def _run_interactive_qemu(
    argv: tuple[str, ...],
    paths: PreviewPaths,
    environment: dict[str, str],
    boot_timeout: int,
    preexec_fn,
    qmp_socket: Path | None = None,
) -> dict:
    """Keep the desktop window open after its serial readiness marker appears."""

    started = time.monotonic()
    marker_after = None
    failure_after = None
    timed_out = False
    framebuffer_captures: dict[str, dict] = {}
    framebuffer_errors: dict[str, str] = {}

    def capture(label: str, output: Path) -> None:
        details, error = _capture_qmp_with_retries(qmp_socket, output)  # type: ignore[arg-type]
        if details is not None:
            framebuffer_captures[label] = details
        else:
            framebuffer_errors[label] = error or "QMP framebuffer capture failed"

    try:
        with paths.qemu_log.open("xb") as handle:
            process = subprocess.Popen(
                argv,
                cwd="/",
                env=environment,
                stdout=handle,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                preexec_fn=preexec_fn,
            )
            while process.poll() is None:
                elapsed = time.monotonic() - started
                if marker_after is None and paths.serial_log.is_file():
                    try:
                        serial = paths.serial_log.read_text(encoding="utf-8", errors="replace")
                    except OSError as error:
                        # WSL's DrvFS can transiently report ENODATA while QEMU
                        # keeps the serial file open.  That does not mean the VM
                        # failed, and aborting here used to leave the user with a
                        # running desktop but a misleading launcher failure.
                        if error.errno not in {errno.EAGAIN, errno.EBUSY, errno.ENODATA}:
                            raise
                    else:
                        if "AUREON_DESKTOP_READY" in serial:
                            marker_after = round(elapsed, 3)
                        elif "AUREON_DESKTOP_NOT_READY" in serial:
                            failure_after = round(elapsed, 3)
                if qmp_socket is not None:
                    if marker_after is not None and "ready" not in framebuffer_captures and "ready" not in framebuffer_errors:
                        capture("ready", paths.framebuffer_ready)
                    elif (
                        marker_after is None
                        and elapsed >= QMP_CAPTURE_AFTER_SECONDS
                        and "probe" not in framebuffer_captures
                        and "probe" not in framebuffer_errors
                    ):
                        capture("probe", paths.framebuffer_probe)
                if failure_after is not None:
                    if qmp_socket is not None and "probe" not in framebuffer_captures and "probe" not in framebuffer_errors:
                        capture("probe", paths.framebuffer_probe)
                    _terminate_group(process)
                    break
                if marker_after is None and elapsed >= boot_timeout:
                    timed_out = True
                    _terminate_group(process)
                    break
                time.sleep(0.25)
            returncode = process.wait(timeout=15)
    except FileExistsError as error:
        raise PreviewError("refusing to overwrite QEMU log") from error
    except (OSError, subprocess.TimeoutExpired) as error:
        raise PreviewError("desktop QEMU failed: {0}".format(error)) from error
    if qmp_socket is not None:
        _write_json_once(
            paths.framebuffer_evidence,
            {
                "schema": "aureon.qemu-framebuffer-evidence",
                "version": 1,
                "captures": framebuffer_captures,
                "errors": framebuffer_errors,
            },
        )
    return {
        "returncode": returncode,
        "desktop_ready_after_seconds": marker_after,
        "desktop_failure_after_seconds": failure_after,
        "boot_timeout_reached": timed_out,
        "wall_duration_seconds": round(time.monotonic() - started, 3),
        "framebuffer": {"captures": framebuffer_captures, "errors": framebuffer_errors},
    }


def _extract_guest_evidence(serial_log: Path) -> dict[str, dict]:
    """Decode bounded JSON reports emitted by the reviewed guest readiness probe."""

    try:
        serial = serial_log.read_text(encoding="utf-8", errors="replace")
    except OSError as error:
        raise PreviewError("desktop serial evidence is unreadable: {0}".format(error)) from error
    reports: dict[str, dict] = {}
    pattern = re.compile(r"AUREON_EVIDENCE (baseline|core|services)=([A-Za-z0-9+/=]{4,262144})")
    for name, encoded in pattern.findall(serial):
        try:
            decoded = base64.b64decode(encoded, validate=True)
            parsed = json.loads(decoded.decode("utf-8"))
        except (ValueError, binascii.Error, UnicodeDecodeError, json.JSONDecodeError) as error:
            raise PreviewError("guest {0} evidence is invalid".format(name)) from error
        if not isinstance(parsed, dict) or parsed.get("schema") != "aureon.control-plane-report":
            raise PreviewError("guest {0} evidence has an unexpected schema".format(name))
        reports[name] = parsed
    return reports


def _extract_guest_session_state(serial_log: Path) -> dict[str, str]:
    """Extract the small allowlisted readiness state from the serial log."""

    try:
        serial = serial_log.read_text(encoding="utf-8", errors="replace")
    except OSError as error:
        raise PreviewError("desktop serial evidence is unreadable: {0}".format(error)) from error
    state: dict[str, str] = {}
    for key in (
        "probe_state",
        "session",
        "kwin_wayland",
        "plasmashell",
        "appearance_state",
        "display_requested",
        "display_state",
        "failure_reason",
    ):
        matches = re.findall(r"{0}=([A-Za-z0-9@._-]+)".format(re.escape(key)), serial)
        if matches:
            state[key] = matches[-1]
    return state


def create_existing_launch_plan(
    build_id: str,
    session_id: str,
    boot_timeout: int,
    acceleration: str,
    video: str = DEFAULT_VIDEO_ADAPTER,
    gtk_backend: str = DEFAULT_GTK_BACKEND,
) -> dict:
    """Render the no-write plan for a new overlay on a preserved base image."""

    base = preview_paths(build_id, ROOT)
    session = existing_session_paths(build_id, session_id, ROOT)
    if acceleration not in {"auto", "kvm", "tcg"}:
        raise PreviewError("--accel must be auto, kvm, or tcg")
    if video not in {"virtio", "std"}:
        raise PreviewError("--video must be virtio or std")
    if gtk_backend not in {"auto", "x11", "wayland"}:
        raise PreviewError("--gtk-backend must be auto, x11, or wayland")
    if not MINIMUM_BOOT_TIMEOUT <= boot_timeout <= MAXIMUM_BOOT_TIMEOUT:
        raise PreviewError(
            "--boot-timeout-seconds must be between {0} and {1}".format(MINIMUM_BOOT_TIMEOUT, MAXIMUM_BOOT_TIMEOUT)
        )
    return {
        "schema": "aureon.desktop-existing-launch-plan",
        "version": 1,
        "command": "desktop-preview --run-existing",
        "build_id": build_id,
        "session_id": session_id,
        "execution": {
            "mode": "dry-run",
            "build_network": "not used",
            "guest_network": "disabled",
            "boot_timeout_seconds": boot_timeout,
            "acceleration_policy": acceleration,
            "video_adapter": video,
            "gtk_backend": gtk_backend,
            "requested_display": {
                "width": DEFAULT_DISPLAY_WIDTH,
                "height": DEFAULT_DISPLAY_HEIGHT,
                "refresh_hz": DEFAULT_DISPLAY_REFRESH_HZ,
                "scale": 1.0,
            },
        },
        "safety": {
            "base_qcow2_reused_read_only": True,
            "writes_limited_to_new_session_overlay": True,
            "host_disk_paths_accepted": False,
            "host_directories_shared_with_guest": False,
            "physical_usb_passthrough": False,
            "windows_install_or_boot_changes": False,
        },
        "paths": {
            "base_qcow2": _relative(base.disk, ROOT),
            "new_overlay": _relative(session.overlay, ROOT),
            "new_serial_log": _relative(session.serial_log, ROOT),
            "new_qemu_log": _relative(session.qemu_log, ROOT),
            "new_framebuffer_probe": _relative(session.framebuffer_probe, ROOT),
            "new_framebuffer_ready": _relative(session.framebuffer_ready, ROOT),
            "new_framebuffer_evidence": _relative(session.framebuffer_evidence, ROOT),
        },
    }


def _validate_existing_preview(paths: PreviewPaths, qemu_img: str, environment: dict[str, str], root: Path) -> dict:
    """Require preserved conversion evidence before a base image can be reused."""

    for candidate, label in ((paths.build_root, "desktop build root"), (paths.image_root, "desktop image root"), (paths.work_root, "desktop work root")):
        _require_inside(candidate, root, label)
        if candidate.is_symlink() or not candidate.is_dir():
            raise PreviewError("existing {0} is missing or unsafe: '{1}'".format(label, candidate))
    if paths.qcow2_evidence.is_symlink() or not paths.qcow2_evidence.is_file():
        raise PreviewError("existing desktop qcow2 evidence is missing")
    try:
        recorded = json.loads(paths.qcow2_evidence.read_text(encoding="utf-8"))
        completed = json.loads(paths.result.read_text(encoding="utf-8"))
        preview = json.loads(paths.preview_evidence.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise PreviewError("existing desktop is not a completed current-contract preview") from error
    if recorded.get("status") != "passed" or not isinstance(recorded.get("sha256"), str):
        raise PreviewError("existing desktop qcow2 was not recorded as a passed conversion")
    if completed.get("status") != "passed" or preview.get("schema") != "aureon.desktop-preview-evidence":
        raise PreviewError("existing desktop did not pass the current visual readiness contract")
    qemu_evidence = preview.get("qemu") if isinstance(preview.get("qemu"), dict) else {}
    guest_evidence = qemu_evidence.get("guest_evidence") if isinstance(qemu_evidence.get("guest_evidence"), dict) else {}
    guest_session = qemu_evidence.get("guest_session") if isinstance(qemu_evidence.get("guest_session"), dict) else {}
    framebuffer = qemu_evidence.get("framebuffer") if isinstance(qemu_evidence.get("framebuffer"), dict) else {}
    ready_capture = framebuffer.get("captures", {}).get("ready") if isinstance(framebuffer.get("captures"), dict) else None
    if {"baseline", "core", "services"} - set(guest_evidence):
        raise PreviewError("existing desktop lacks current baseline/core/services evidence")
    if guest_session.get("display_state") != "observed-1920x1080@60":
        raise PreviewError("existing desktop lacks current Full HD runtime evidence")
    if not isinstance(ready_capture, dict) or not ready_capture.get("visually_non_uniform"):
        raise PreviewError("existing desktop lacks a verified non-uniform framebuffer")
    inspected = _inspect_qcow2(paths, qemu_img, environment, root)
    if inspected["sha256"] != recorded["sha256"]:
        raise PreviewError("existing base qcow2 no longer matches its recorded sha256")
    return inspected


def _create_existing_session_root(session: ExistingSessionPaths, root: Path) -> None:
    """Create one new session directory without changing the preserved overlay."""

    session_parent = session.session_root.parent
    _require_inside(session_parent, root, "desktop session parent")
    if session_parent.exists() and (session_parent.is_symlink() or not session_parent.is_dir()):
        raise PreviewError("desktop session parent is unsafe: '{0}'".format(session_parent))
    if session.session_root.exists() or session.session_root.is_symlink():
        raise PreviewError("refusing to overwrite existing desktop session '{0}'".format(session.session_root.name))
    try:
        session_parent.mkdir(mode=0o700, exist_ok=True)
        session.session_root.mkdir(mode=0o700)
    except OSError as error:
        raise PreviewError("could not create a new desktop session root: {0}".format(error)) from error


def _transfer_existing_session_to_user(session: ExistingSessionPaths, uid: int, gid: int) -> None:
    """Permit the visible QEMU process to write only its fresh virtual overlay."""

    for candidate, mode in ((session.session_root, 0o700), (session.vars_copy, 0o600), (session.overlay, 0o600)):
        if candidate.is_symlink():
            raise PreviewError("desktop session artifact became a symlink: '{0}'".format(candidate))
        try:
            os.chown(candidate, uid, gid)
            os.chmod(candidate, mode)
        except OSError as error:
            raise PreviewError("could not transfer desktop session artifact to the WSL user: {0}".format(error)) from error


def run_existing_preview(plan: dict, base: PreviewPaths, session: ExistingSessionPaths, root: Path) -> dict:
    """Open a preserved qcow2 using a new copy-on-write session overlay only."""

    preflight = _validate_runtime_preflight(
        root,
        plan["execution"]["acceleration_policy"],
        plan["execution"].get("gtk_backend", DEFAULT_GTK_BACKEND),
    )
    qemu = preflight["executables"]["qemu"]
    qemu_img = preflight["executables"]["qemu_img"]
    environment = preflight["environment"]
    inspected = _validate_existing_preview(base, qemu_img, environment, root)
    _create_existing_session_root(session, root)
    try:
        _copy_file_exclusive(OVMF_VARS, session.vars_copy)
        _run_logged(
            (qemu_img, "create", "-f", "qcow2", "-F", "qcow2", "-b", str(base.disk), str(session.overlay)),
            session.overlay_log,
            environment,
            120,
        )
        uid, gid, _, _, groups = preflight["identity"]
        _make_base_readonly_for_preview(base)
        _transfer_existing_session_to_user(session, uid, gid)
        qmp_directory, qmp_socket = _prepare_qmp_runtime(session, uid, gid)
        try:
            command = qemu_command(
                session,
                qemu,
                preflight["acceleration"],
                plan["execution"].get("video_adapter", DEFAULT_VIDEO_ADAPTER),
                qmp_socket,
            )
            print("[Aureon] Abriendo el escritorio ya creado con un overlay nuevo; no se reconstruira ni modificara la imagen base.", file=sys.stderr, flush=True)
            qemu_result = _run_interactive_qemu(
                command,
                session,
                preflight["gui_environment"],
                plan["execution"]["boot_timeout_seconds"],
                _qemu_preexec(uid, gid, groups),
                qmp_socket,
            )
        finally:
            _cleanup_qmp_runtime(qmp_directory, qmp_socket)
        if qemu_result["boot_timeout_reached"]:
            raise PreviewError("existing desktop did not emit its readiness marker before the configured boot timeout")
        if qemu_result["desktop_failure_after_seconds"] is not None:
            failed_state = _extract_guest_session_state(session.serial_log)
            raise PreviewError(
                "existing guest desktop reported a readiness failure: {0}; inspect serial and framebuffer evidence".format(
                    failed_state.get("failure_reason", "unknown")
                )
            )
        if qemu_result["returncode"] != 0:
            raise PreviewError("existing desktop QEMU exited {0}; inspect its preserved log".format(qemu_result["returncode"]))
        if qemu_result["desktop_ready_after_seconds"] is None:
            raise PreviewError("existing desktop QEMU exited without the readiness marker")
        guest_evidence = _extract_guest_evidence(session.serial_log)
        guest_session = _extract_guest_session_state(session.serial_log)
        missing_guest_evidence = sorted({"baseline", "core", "services"} - set(guest_evidence))
        if missing_guest_evidence:
            raise PreviewError(
                "existing desktop lacks current guest evidence: {0}".format(", ".join(missing_guest_evidence))
            )
        if guest_session.get("display_state") != "observed-1920x1080@60":
            raise PreviewError("existing desktop did not verify the requested 1920x1080@60 guest mode")
        ready_framebuffer = qemu_result["framebuffer"]["captures"].get("ready")
        if not ready_framebuffer or not ready_framebuffer.get("visually_non_uniform"):
            raise PreviewError("existing desktop did not produce a non-uniform ready framebuffer")
        if (ready_framebuffer.get("width"), ready_framebuffer.get("height")) != (1920, 1080):
            raise PreviewError("existing desktop framebuffer is not 1920x1080")
        base_hash_after = _hash_file(base.disk)
        if base_hash_after != inspected["sha256"]:
            raise PreviewError("the preserved base qcow2 changed; refusing to report a usable session")
        overlay_check = _capture((qemu_img, "check", str(session.overlay)), environment, 180).strip()
        result = {
            "build_id": plan["build_id"],
            "session_id": plan["session_id"],
            "status": "passed",
            "desktop_ready_after_seconds": qemu_result["desktop_ready_after_seconds"],
            "wall_duration_seconds": qemu_result["wall_duration_seconds"],
            "guest_network": "disabled",
            "guest_evidence": guest_evidence,
            "guest_session": guest_session,
            "framebuffer": qemu_result["framebuffer"],
            "qemu": {
                "arguments": list(command[1:]),
                "video_adapter": plan["execution"].get("video_adapter", DEFAULT_VIDEO_ADAPTER),
                "gtk_backend": plan["execution"].get("gtk_backend", DEFAULT_GTK_BACKEND),
                "requested_display": plan["execution"].get("requested_display"),
            },
            "base_qcow2_sha256_before_and_after": base_hash_after,
            "overlay_integrity_check": overlay_check or "qemu-img check exited 0",
            "artifacts": {
                "base_qcow2": _relative(base.disk, root),
                "overlay": _relative(session.overlay, root),
                "serial_log": _relative(session.serial_log, root),
                "qemu_log": _relative(session.qemu_log, root),
                "framebuffer_evidence": _relative(session.framebuffer_evidence, root),
            },
        }
        _write_json_once(session.evidence, result)
        return result
    except (OSError, PreviewError) as error:
        failed = {
            "build_id": plan["build_id"],
            "session_id": plan["session_id"],
            "status": "failed",
            "error": str(error),
        }
        try:
            if session.session_root.is_dir() and not session.evidence.exists():
                _write_json_once(session.evidence, failed)
        except (OSError, PreviewError):
            pass
        raise PreviewError(str(error)) from error


def _utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def execute(plan: dict, paths: PreviewPaths, root: Path) -> dict:
    """Build the reviewed desktop image, then open its isolated QEMU window."""

    preflight = _validate_preflight(
        root,
        plan["execution"]["acceleration_policy"],
        plan["execution"].get("gtk_backend", DEFAULT_GTK_BACKEND),
    )
    _require_unused_roots(paths, root)
    expected_sources = plan["inputs"]["source_digest"]
    if _source_digest(root)[1] != expected_sources:
        raise PreviewError("desktop sources changed after planning; create a new plan before running")
    started = _utc_now()
    base_result = {"build_id": plan["build_id"], "command": "desktop-preview", "started_at_utc": started}
    conversion_started = False
    try:
        _create_roots(paths, plan, root)
        podman_prefix = preflight["podman_prefix"]
        environment = preflight["environment"]
        qemu = preflight["executables"]["qemu"]
        qemu_img = preflight["executables"]["qemu_img"]
        tag = "localhost/aureon-desktop-preview:{0}".format(plan["build_id"])
        print("[Aureon] Descargando y preparando KDE dentro de Ubuntu WSL; puede tardar varios minutos...", file=sys.stderr, flush=True)
        build = _run_logged(
            podman_prefix
            + (
                "build",
                "--pull=never",
                "--network=host",
                "--http-proxy=false",
                "--no-cache",
                "--format",
                "oci",
                "--file",
                str(root / "system" / "desktop" / "Containerfile"),
                "--tag",
                tag,
                str(root / "system" / "desktop"),
            ),
            paths.oci_log,
            environment,
            None,
        )
        digest = _capture(
            podman_prefix + ("image", "inspect", "--format", "{{.Digest}}", tag), environment, 60
        ).strip()
        if not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
            raise PreviewError("desktop OCI image did not expose an immutable sha256 digest")
        platform_name = _capture(
            podman_prefix + ("image", "inspect", "--format", "{{.Os}}/{{.Architecture}}", tag), environment, 60
        ).strip()
        if platform_name != "linux/amd64":
            raise PreviewError("desktop OCI platform must be linux/amd64")
        if _source_digest(root)[1] != expected_sources:
            raise PreviewError("desktop sources changed during the OCI build")
        immutable = "localhost/aureon-desktop-preview@{0}".format(digest)
        _write_json_once(
            paths.oci_evidence,
            {
                "build_id": plan["build_id"],
                "derived_oci": immutable,
                "local_tag": tag,
                "platform": platform_name,
                "build_network": "host, only for the explicit Fedora package fetch stage",
                "guest_network": "disabled",
                "source_digest": expected_sources,
                "stage": build,
                "status": "passed",
            },
        )
        package_query = _capture(
            podman_prefix
            + (
                "run",
                "--rm",
                "--pull=never",
                "--network=none",
                "--entrypoint",
                "/usr/bin/rpm",
                immutable,
                "-qa",
                "--qf",
                "%{NAME}\\t%{EPOCH}\\t%{VERSION}\\t%{RELEASE}\\t%{ARCH}\\n",
            ),
            environment,
            180,
        )
        _write_json_once(
            paths.package_lock,
            {
                "schema": "aureon.desktop-package-inventory",
                "version": 1,
                "build_id": plan["build_id"],
                "source_oci": immutable,
                "network": "disabled",
                **_package_inventory(package_query),
            },
        )
        installed_storage = PODMAN_CONFIG / "storage.conf"
        installed_containers = PODMAN_CONFIG / "containers.conf"
        converter_name = "aureon-desktop-convert-" + plan["build_id"]
        conversion_started = True
        try:
            print("[Aureon] Creando el disco virtual qcow2; Windows no se está instalando ni modificando...", file=sys.stderr, flush=True)
            conversion = _run_logged(
                podman_prefix
                + (
                    "run",
                    "--rm",
                    "--name",
                    converter_name,
                    "--cidfile",
                    str(paths.conversion_cid),
                    "--label",
                    "io.aureon.desktop.preview={0}".format(plan["build_id"]),
                    "--privileged",
                    "--pull=never",
                    "--network=none",
                    "-e",
                    "CONTAINERS_STORAGE_CONF=/etc/containers/storage.conf",
                    "-v",
                    "{0}:/etc/containers/storage.conf:ro".format(installed_storage),
                    "-v",
                    "{0}:/etc/containers/containers.conf:ro".format(installed_containers),
                    "-v",
                    "{0}:{0}:rw".format(PODMAN_STORE),
                    "-v",
                    "{0}:/var/lib/containers/storage:rw".format(PODMAN_STORE),
                    "-v",
                    "{0}:/output:rw".format(paths.image_root),
                    IMAGE_BUILDER_REFERENCE,
                    "--output-dir",
                    "/output",
                    "build",
                    "qcow2",
                    "--bootc-ref",
                    immutable,
                    "--bootc-default-fs",
                    "ext4",
                    "--image-size",
                    str(DESKTOP_IMAGE_SIZE_BYTES),
                    "--output-name",
                    "aureon-desktop",
                    "--with-manifest",
                    "--with-buildlog",
                    "--progress",
                    "verbose",
                ),
                paths.conversion_log,
                environment,
                CONVERSION_TIMEOUT,
            )
        except BaseException:
            _cleanup_conversion(podman_prefix, paths.conversion_cid, paths.conversion_cleanup_log, plan["build_id"], environment)
            raise
        qcow2 = _inspect_qcow2(paths, qemu_img, environment, root)
        _write_json_once(
            paths.qcow2_evidence,
            {
                "build_id": plan["build_id"],
                "conversion": conversion,
                "guest_network": "disabled",
                "source_oci": immutable,
                "status": "passed",
                **qcow2,
            },
        )
        base_hash_before = qcow2["sha256"]
        _copy_file_exclusive(OVMF_VARS, paths.vars_copy)
        _run_logged(
            (qemu_img, "create", "-f", "qcow2", "-F", "qcow2", "-b", str(paths.disk), str(paths.overlay)),
            paths.overlay_log,
            environment,
            120,
        )
        uid, gid, _, _, groups = preflight["identity"]
        _make_base_readonly_for_preview(paths)
        _transfer_work_to_user(paths, uid, gid)
        qmp_directory, qmp_socket = _prepare_qmp_runtime(paths, uid, gid)
        command = qemu_command(
            paths,
            qemu,
            preflight["acceleration"],
            plan["execution"].get("video_adapter", DEFAULT_VIDEO_ADAPTER),
            qmp_socket,
        )
        print("[Aureon] Abriendo la ventana del escritorio KDE. Apágala desde el menú cuando termines.", file=sys.stderr, flush=True)
        try:
            qemu_result = _run_interactive_qemu(
                command,
                paths,
                preflight["gui_environment"],
                plan["execution"]["boot_timeout_seconds"],
                _qemu_preexec(uid, gid, groups),
                qmp_socket,
            )
        finally:
            _cleanup_qmp_runtime(qmp_directory, qmp_socket)
        if qemu_result["boot_timeout_reached"]:
            raise PreviewError("desktop did not emit its readiness marker before the configured boot timeout")
        if qemu_result["desktop_failure_after_seconds"] is not None:
            failed_state = _extract_guest_session_state(paths.serial_log)
            raise PreviewError(
                "guest desktop reported a readiness failure: {0}; inspect serial and framebuffer evidence".format(
                    failed_state.get("failure_reason", "unknown")
                )
            )
        if qemu_result["returncode"] != 0:
            raise PreviewError("QEMU exited {0}; inspect its preserved log".format(qemu_result["returncode"]))
        if qemu_result["desktop_ready_after_seconds"] is None:
            raise PreviewError("desktop QEMU exited without the readiness marker")
        guest_evidence = _extract_guest_evidence(paths.serial_log)
        guest_session = _extract_guest_session_state(paths.serial_log)
        missing_guest_evidence = sorted({"baseline", "core", "services"} - set(guest_evidence))
        if missing_guest_evidence:
            raise PreviewError(
                "desktop readiness did not provide required guest evidence: {0}".format(
                    ", ".join(missing_guest_evidence)
                )
            )
        if guest_session.get("display_state") != "observed-1920x1080@60":
            raise PreviewError("desktop readiness did not verify the requested 1920x1080@60 guest mode")
        ready_framebuffer = qemu_result["framebuffer"]["captures"].get("ready")
        if not ready_framebuffer or not ready_framebuffer.get("visually_non_uniform"):
            raise PreviewError("desktop readiness did not produce a non-uniform framebuffer capture")
        if (ready_framebuffer.get("width"), ready_framebuffer.get("height")) != (1920, 1080):
            raise PreviewError("desktop ready framebuffer is not 1920x1080")
        base_hash_after = _hash_file(paths.disk)
        if base_hash_before != base_hash_after:
            raise PreviewError("the base desktop qcow2 changed; refusing to report a usable preview")
        overlay_check = _capture((qemu_img, "check", str(paths.overlay)), environment, 180).strip()
        preview = {
            "schema": "aureon.desktop-preview-evidence",
            "version": 1,
            "build_id": plan["build_id"],
            "status": "passed",
            "desktop_ready_after_seconds": qemu_result["desktop_ready_after_seconds"],
            "wall_duration_seconds": qemu_result["wall_duration_seconds"],
            "qemu": {
                "arguments": list(command[1:]),
                "acceleration": preflight["acceleration"],
                "guest_network": "none",
                "host_directories_shared_with_guest": False,
                "physical_usb_passthrough": False,
                "base_qcow2_sha256_before_and_after": base_hash_after,
                "overlay_integrity_check": overlay_check or "qemu-img check exited 0",
                "display": "gtk,gl=off via WSLg",
                "video_adapter": plan["execution"].get("video_adapter", DEFAULT_VIDEO_ADAPTER),
                "gtk_backend": plan["execution"].get("gtk_backend", DEFAULT_GTK_BACKEND),
                "requested_display": plan["execution"].get("requested_display"),
                "guest_evidence": guest_evidence,
                "guest_session": guest_session,
                "framebuffer": qemu_result["framebuffer"],
            },
            "artifacts": {
                "base_qcow2": _relative(paths.disk, root),
                "package_inventory": _relative(paths.package_lock, root),
                "overlay": _relative(paths.overlay, root),
                "serial_log": _relative(paths.serial_log, root),
                "qemu_log": _relative(paths.qemu_log, root),
                "framebuffer_evidence": _relative(paths.framebuffer_evidence, root),
                "framebuffer_ready": _relative(paths.framebuffer_ready, root),
            },
        }
        _write_json_once(paths.preview_evidence, preview)
        result = dict(base_result)
        result.update({"completed_at_utc": _utc_now(), "status": "passed", "preview": _relative(paths.preview_evidence, root)})
        _write_json_once(paths.result, result)
        return result
    except (OSError, PreviewError) as error:
        failed = dict(base_result)
        failed.update({"completed_at_utc": _utc_now(), "status": "failed", "error": str(error)})
        try:
            if paths.build_root.is_dir() and not paths.result.exists():
                _write_json_once(paths.result, failed)
        except (OSError, PreviewError):
            pass
        raise PreviewError(str(error)) from error


def build_parser() -> argparse.ArgumentParser:
    """Build the safe dry-run-first command line interface."""

    parser = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Prepare or open the isolated Aureon KDE desktop preview in a WSLg QEMU window.",
    )
    parser.add_argument("--build-id", default="desktop-preview", help="new portable preview identifier")
    parser.add_argument(
        "--run-existing",
        action="store_true",
        help="open a verified existing preview with a new disposable overlay; never rebuilds the base image",
    )
    parser.add_argument(
        "--session-id",
        default="session-01",
        help="new portable session identifier required to avoid overwriting a prior overlay",
    )
    parser.add_argument("--dry-run", action="store_true", help="print the no-write plan (default)")
    parser.add_argument("--execute", action="store_true", help="build the VM image and open its disposable QEMU window")
    parser.add_argument(
        "--allow-build-network",
        action="store_true",
        help="acknowledge the one package-fetch stage; conversion and guest networking remain disabled",
    )
    parser.add_argument(
        "--boot-timeout-seconds",
        type=int,
        default=DEFAULT_BOOT_TIMEOUT,
        help="maximum seconds to wait for the desktop marker before the window is stopped",
    )
    parser.add_argument("--accel", choices=("auto", "kvm", "tcg"), default="auto")
    parser.add_argument(
        "--video",
        choices=("virtio", "std"),
        default=DEFAULT_VIDEO_ADAPTER,
        help="virtual video adapter; virtio is the default and std is a compatibility fallback",
    )
    parser.add_argument(
        "--gtk-backend",
        choices=("auto", "x11", "wayland"),
        default=DEFAULT_GTK_BACKEND,
        help="WSLg GTK frontend; x11 avoids blank GTK/Wayland windows on affected systems",
    )
    return parser


def main(argv: list[str] | None = None, output=None) -> int:
    """Run a no-write plan by default, or the explicitly authorized desktop flow."""

    output = output if output is not None else sys.stdout
    args = build_parser().parse_args(argv)
    if args.dry_run and args.execute:
        print("{0}: choose either --dry-run or --execute, not both".format(PROGRAM), file=output)
        return 4
    try:
        build_id = validate_build_id(args.build_id)
        paths = preview_paths(build_id, ROOT)
        if args.run_existing:
            session = existing_session_paths(build_id, args.session_id, ROOT)
            plan = create_existing_launch_plan(
                build_id,
                args.session_id,
                args.boot_timeout_seconds,
                args.accel,
                args.video,
                args.gtk_backend,
            )
        else:
            session = None
            plan = create_plan(build_id, args.boot_timeout_seconds, args.accel, ROOT, args.video, args.gtk_backend)
    except PreviewError as error:
        print("{0}: rejected: {1}".format(PROGRAM, error), file=output)
        return 4
    if not args.execute:
        print(json.dumps(plan, ensure_ascii=True, indent=2, sort_keys=True), file=output)
        return 0
    if args.run_existing and args.allow_build_network:
        print("{0}: --run-existing never uses build networking; omit --allow-build-network".format(PROGRAM), file=output)
        return 4
    if not args.run_existing and not args.allow_build_network:
        print(
            "{0}: --execute requires --allow-build-network because the first desktop image fetches the explicitly listed Fedora packages. The guest VM remains offline.".format(PROGRAM),
            file=output,
        )
        return 4
    try:
        if args.run_existing:
            if session is None:
                raise PreviewError("existing desktop session was not planned")
            result = run_existing_preview(plan, paths, session, ROOT)
        else:
            _require_unused_roots(paths, ROOT)
            result = execute(plan, paths, ROOT)
    except PreviewError as error:
        print("{0}: stopped safely: {1}".format(PROGRAM, error), file=output)
        print("Any evidence already created is kept. Windows, its boot settings, and physical disks were not targets.", file=output)
        return 6
    print(json.dumps(result, ensure_ascii=True, indent=2, sort_keys=True), file=output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

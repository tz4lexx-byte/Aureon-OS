#!/usr/bin/env python3
"""Run the checked-in Aureon control-plane implementation from a checkout."""

from __future__ import annotations

import runpy
from pathlib import Path


SCRIPT = Path(__file__).resolve().parent.parent / "system" / "desktop" / "overlays" / "usr" / "libexec" / "aureon" / "aureonctl"

if __name__ == "__main__":
    runpy.run_path(str(SCRIPT), run_name="__main__")

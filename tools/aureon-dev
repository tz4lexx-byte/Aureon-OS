class WorkspaceScopeError(ValueError):
    """Raised when a requested workspace is not safely inside this checkout."""


class PlanValidationError(ValueError):
    """Raised when a dry-run plan requests an unsafe or ambiguous input."""


def _windows_path_components(path):
    """Yield path components using both Windows and POSIX separators.

    Planning input must remain portable even when the CLI is run in WSL or on
    Linux.  Treating both separators as delimiters prevents a Linux dry-run
    from accepting a destination that Windows would interpret differently.
    """

    return tuple(
        component
        for component in re.split(r"[\\\\/]+", os.fspath(path))
        if component and component not in {".", ".."}
    )


def is_windows_reserved_name(name):
    """Return whether one Windows path component denotes a device alias."""

    normalized = str(name).rstrip(" .")
    if not normalized:
        return False
    basename = normalized.split(".", 1)[0].rstrip(" ").casefold()
    return basename in WINDOWS_RESERVED_DEVICE_BASENAMES


def validate_windows_portable_relative_path(path, label):
    """Reject Windows-reserved or lossy components below the checkout root."""

    for component in _windows_path_components(path):
        if component.endswith((".", " ")):
            raise PlanValidationError(
                "{0} contains a Windows-unsafe path component ending in '.' or space: '{1}'"
                .format(label, component)
            )
        if is_windows_reserved_name(component):
            raise PlanValidationError(
                "{0} contains a Windows-reserved device name: '{1}'".format(label, component)
            )


def is_remote_or_unc_path(path):
    """Recognize UNC paths and URI-style locations that must stay local-only."""

    raw = os.fspath(path).strip()
    windows = raw.replace("/", "\\")
    return windows.startswith("\\\\") or bool(
        re.match(r"^[a-z][a-z0-9+.-]*://", raw, flags=re.IGNORECASE)
    )



            action="store_const",
            const="dry-run",
            help="print the versioned plan without creating artifacts (default)",
        )
        mode.add_argument(
            "--execute",
            dest="execution_mode",
            action="store_const",
            const="execute",
            help="reserved; fails closed until a verified implementation exists",

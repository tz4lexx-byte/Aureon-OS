# Aureon Desktop Preview -- never installed onto the Windows host.
#
# This is intentionally separate from ../Containerfile: Phase 0 stays a
# headless, auto-shutting smoke image while this profile is an interactive VM.
FROM quay.io/fedora/fedora-bootc@sha256:86cd97f1e7962e30f52f35ae1c0719299df4f681492b133ea4bcdb74d154fb92

LABEL org.opencontainers.image.title="Aureon OS Desktop Preview"
LABEL org.opencontainers.image.description="KDE Plasma preview for an isolated QEMU VM only"
LABEL org.opencontainers.image.vendor="Aureon OS"
LABEL org.opencontainers.image.source-profile="desktop-preview"

# The first preparation of this developer-only image deliberately uses Fedora
# package repositories.  The launcher requires an explicit --allow-build-network
# acknowledgement for that stage and subsequently converts/runs with no guest
# network.  Package names are listed individually instead of using a mutable
# desktop group, so the visual surface remains reviewable in source control.
RUN mkdir -p /var/roothome && \
    dnf -y install \
      greetd \
      greetd-selinux \
      dbus-daemon \
      plasma-desktop \
      plasma-workspace \
      plasma-workspace-wayland \
      kwin-wayland \
      libkscreen \
      xdg-desktop-portal-kde \
      mesa-dri-drivers \
      pciutils \
      pipewire \
      procps-ng \
      python3 \
      usbutils \
      vulkan-tools \
      wireplumber \
      dolphin \
      konsole && \
    dnf -y clean all && \
    rm -rf /var/cache/dnf

COPY overlays/ /

# `aureon` exists only inside the disposable VM.  Its password is locked and it
# is deliberately not a sudo/wheel user.  greetd starts Plasma for it once per
# boot, so no PC password, guest password, SSH key, or remote login is needed.
RUN chmod 0644 /etc/greetd/config.toml /etc/hostname /etc/issue /etc/issue.net /etc/machine-info /etc/xdg/autostart/aureon-session-ready.desktop /usr/lib/os-release /usr/lib/bootc/kargs.d/20-aureon-desktop-serial.toml /usr/lib/systemd/system/aureon-desktop-ready.service && \
    find /etc/skel/.config /usr/share/color-schemes /usr/share/plasma/desktoptheme/AureonLiquidGlass /usr/share/plasma/look-and-feel/org.aureon.desktop /usr/share/wallpapers/AureonLiquidGlass -type d -exec chmod 0755 {} \; && \
    find /etc/skel/.config /usr/share/color-schemes /usr/share/plasma/desktoptheme/AureonLiquidGlass /usr/share/plasma/look-and-feel/org.aureon.desktop /usr/share/wallpapers/AureonLiquidGlass -type f -exec chmod 0644 {} \; && \
    chmod 0755 /usr/libexec/aureon/aureon-baseline /usr/libexec/aureon/aureonctl /usr/libexec/aureon/aureon-apply-appearance /usr/libexec/aureon/aureon-plasma-session /usr/libexec/aureon/aureon-display /usr/libexec/aureon/aureon-session-ready /usr/libexec/aureon/aureon-wait-desktop-ready /usr/libexec/aureon/aureon-core /usr/libexec/aureon/aureon-services /usr/libexec/aureon/aureon-hardware /usr/libexec/aureon/aureon-driver /usr/libexec/aureon/aureon-resource /usr/libexec/aureon/aureon-integrity /usr/libexec/aureon/aureon-integrityctl && \
    useradd --create-home --uid 1000 --shell /bin/bash aureon && \
    passwd --lock aureon && \
    install -d -m 0755 /usr/bin && \
    for command in aureonctl aureon-core aureon-services aureon-hardware aureon-driver aureon-resource aureon-integrity aureon-integrityctl; do ln -s ../libexec/aureon/${command} /usr/bin/${command}; done && \
    install -d -m 0755 /usr/lib/systemd/system/multi-user.target.wants && \
    ln -s ../greetd.service /usr/lib/systemd/system/multi-user.target.wants/greetd.service && \
    ln -s ../aureon-desktop-ready.service /usr/lib/systemd/system/multi-user.target.wants/aureon-desktop-ready.service

#!/usr/bin/python3
"""Read-only laptop compatibility report for Aureon live and installed systems."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
from pathlib import Path


def run(*argv: str) -> tuple[int, str]:
    try:
        result = subprocess.run(
            argv, check=False, capture_output=True, text=True, timeout=12
        )
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""
    return result.returncode, (result.stdout + result.stderr).strip()


def command_check(name: str, argv: tuple[str, ...], evidence: str = "") -> dict:
    if shutil.which(argv[0]) is None:
        return {"state": "unsupported", "detail": f"falta {argv[0]}"}
    status, output = run(*argv)
    summary = next((line.strip() for line in output.splitlines() if line.strip()), evidence)
    return {
        "state": "available" if status == 0 else "warning",
        "detail": summary[:240] or evidence or f"salida {status}",
    }


def paths_check(pattern_root: Path, pattern: str, label: str) -> dict:
    matches = sorted(str(path) for path in pattern_root.glob(pattern))
    return {
        "state": "detected" if matches else "not-detected",
        "detail": ", ".join(matches[:4]) if matches else label,
    }


def report() -> dict:
    wifi = command_check("wifi", ("nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device"))
    bluetooth = command_check("bluetooth", ("bluetoothctl", "show"), "adaptador no detectado")
    audio = command_check("audio", ("wpctl", "status"), "PipeWire sin dispositivos visibles")
    camera = paths_check(Path("/dev"), "video*", "ninguna cámara /dev/video* detectada")
    touchpad = command_check("touchpad", ("libinput", "list-devices"), "libinput no respondió")
    suspend = command_check(
        "suspend",
        (
            "busctl",
            "call",
            "org.freedesktop.login1",
            "/org/freedesktop/login1",
            "org.freedesktop.login1.Manager",
            "CanSuspend",
        ),
        "capacidad de suspensión no disponible",
    )
    brightness = paths_check(
        Path("/sys/class/backlight"), "*", "control de brillo no detectado"
    )
    battery = paths_check(
        Path("/sys/class/power_supply"), "BAT*", "batería no detectada"
    )
    graphics = command_check(
        "graphics", ("lspci", "-nnk"), "no se pudo enumerar PCI"
    )
    vulkan = command_check(
        "vulkan", ("vulkaninfo", "--summary"), "Vulkan no disponible"
    )
    radios = command_check("radios", ("rfkill", "list"), "rfkill sin radios")

    session_type = os.environ.get("XDG_SESSION_TYPE", "unknown")
    checks = {
        "wifi": wifi,
        "bluetooth": bluetooth,
        "audio": audio,
        "camera": camera,
        "touchpad": touchpad,
        "suspend_capability": suspend,
        "battery": battery,
        "brightness": brightness,
        "graphics_pci": graphics,
        "vulkan": vulkan,
        "radio_switches": radios,
    }
    return {
        "schema": "aureon.laptop-compatibility",
        "version": 1,
        "read_only": True,
        "session_type": session_type,
        "checks": checks,
        "manual_tests": [
            "Conectar y desconectar Wi-Fi y Bluetooth.",
            "Reproducir y grabar audio; comprobar micrófono.",
            "Abrir la cámara y verificar imagen.",
            "Probar clic, desplazamiento y gestos del touchpad.",
            "Suspender manualmente, esperar 30 segundos y reanudar.",
            "Cerrar y abrir la tapa con el equipo conectado y con batería.",
            "Cambiar brillo y perfil de energía.",
            "Ejecutar un juego corto y una grabación de OBS.",
        ],
        "notes": [
            "not-detected es normal en una VM o en equipos sin ese dispositivo.",
            "NVIDIA propietario no se instala automáticamente; se evalúa después del arranque.",
            "Este chequeo nunca suspende, instala, particiona ni modifica firmware.",
        ],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="emitir JSON")
    arguments = parser.parse_args()
    payload = report()
    if arguments.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False, sort_keys=True))
    else:
        print("Aureon — compatibilidad de laptop (solo lectura)")
        print(f"Sesión: {payload['session_type']}")
        for name, check in payload["checks"].items():
            print(f"{name:20} {check['state']:14} {check['detail']}")
        print("\nPruebas manuales pendientes:")
        for item in payload["manual_tests"]:
            print(f"- {item}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

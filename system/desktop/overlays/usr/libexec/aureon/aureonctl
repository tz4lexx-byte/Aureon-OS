def _baseline_report() -> dict[str, Any]:
    script = Path(__file__).with_name("aureon-baseline")
    if not script.is_file():
        return {"state": "unavailable", "reason": "aureon-baseline is not installed"}
    result = _safe_command(("bash", str(script)), timeout=30)
    if result["state"] != "available":
        return {"state": "failed", "runner": result}
    metrics: dict[str, str] = {}
    for line in str(result["stdout"]).splitlines():
        if "=" in line and not line.startswith((" ", "\t")):
            key, value = line.split("=", 1)
            metrics[key] = value
    return {"state": "available", "metrics": metrics, "raw_sections_omitted": True}


def _query_rpm_packages(names: tuple[str, ...]) -> dict[str, Any]:
    """Query only the fixed package names supplied by an internal catalogue."""

    result = _safe_command(("rpm", "-q", "--qf", "%{NAME}\n") + names, timeout=20)
    if result["state"] == "unavailable":
        return {"state": "unavailable", "installed": [], "missing": list(names)}
    installed = sorted(
        set(str(result.get("stdout", "")).splitlines()).intersection(names)
    )
    missing = sorted(set(names) - set(installed))
    return {"state": "available", "installed": installed, "missing": missing}


def _core_report() -> dict[str, Any]:
    """Verify the minimal desktop package surface without installing anything."""

    required = _query_rpm_packages(CORE_PACKAGES)
    prohibited = _query_rpm_packages(PROHIBITED_AUTOMATIC_PACKAGES)
    if required["state"] == "unavailable":
        state = "unavailable"
    elif required["missing"] or prohibited["installed"]:
        state = "failed"
    else:
        state = "passed"
    return {
        "state": state,
        "inspection": "rpm database only; no package operation is performed",
        "required_packages": list(CORE_PACKAGES),
        "required_installed": required["installed"],
        "required_missing": required["missing"],
        "optional_components_forbidden_from_core": list(PROHIBITED_AUTOMATIC_PACKAGES),
        "optional_components_found_in_core": prohibited["installed"],
        "desktop_commands": {
            command: _tool_state(command)
            for command in ("startplasma-wayland", "kwin_wayland", "plasmashell", "dolphin", "konsole")
        },
    }


def _service_report() -> dict[str, Any]:
    """Check only declared session-only units; never enumerate user processes."""

    units = tuple(unit for group in SESSION_ONLY_UNITS.values() for unit in group)
    active_result = _safe_command(("systemctl", "is-active") + units, timeout=15)
    enabled_result = _safe_command(("systemctl", "is-enabled") + units, timeout=15)
    if active_result["state"] == "unavailable":
        return {
            "state": "unavailable",
            "scope": "declared session-only units",
            "units": list(units),
            "process_list_observed": False,
        }

    active_lines = str(active_result.get("stdout", "")).splitlines()
    enabled_lines = str(enabled_result.get("stdout", "")).splitlines()
    states: dict[str, dict[str, str]] = {}
    violations: list[str] = []
    for index, unit in enumerate(units):
        active = active_lines[index].strip() if index < len(active_lines) else "unknown"
        enabled = enabled_lines[index].strip() if index < len(enabled_lines) else "unknown"
        states[unit] = {"active": active, "enabled": enabled}
        if active in {"active", "activating", "reloading"}:
            violations.append(unit + " is active outside an authorized session")
        if enabled in {"enabled", "enabled-runtime"}:
            violations.append(unit + " is enabled at boot")
    return {
        "state": "passed" if not violations else "failed",
        "scope": "declared session-only units",
        "classes": {name: list(group) for name, group in SESSION_ONLY_UNITS.items()},
        "units": states,
        "violations": violations,
        "process_list_observed": False,
        "network_used": False,
    }


def _reproducibility_report() -> dict[str, Any]:
    """Report source controls and remaining gates without creating a build."""

    root = _repo_root()
    if root is None:
        return {
            "state": "partial",
            "reason": "runtime image has no checkout; inspect its build evidence externally",
        }
    desktop_root = root / "system" / "desktop"
    generated = sorted(
        item.relative_to(root).as_posix()
        for item in desktop_root.rglob("*")
        if item.is_file() and ("__pycache__" in item.parts or item.suffix in {".pyc", ".pyo"})
    )
    ignore_source = _safe_read(desktop_root / ".containerignore") or ""
    exclusions_present = "**/__pycache__/**" in ignore_source and "**/*.pyc" in ignore_source
    package_evidence = sorted((root / "build").glob("desktop-*/desktop-packages.lock.json")) if (root / "build").is_dir() else []
    return {
        "state": "foundation-passed" if exclusions_present else "failed",
        "base_image_pinned_by_digest": "FROM quay.io/fedora/fedora-bootc@sha256:" in (_safe_read(desktop_root / "Containerfile") or ""),
        "generated_inputs_excluded": exclusions_present,
        "excluded_generated_files_present_locally": generated,
        "package_inventory_evidence": [item.relative_to(root).as_posix() for item in package_evidence],
        "remaining_release_gates": [
            "capture the next package inventory",
            "repeat from a clean checkout",
            "compare two package inventories and qcow2 manifests",
        ],
        "writes_performed": False,
        "network_used": False,
    }


def _validate_toml(path: Path) -> str | None:
    """Parse TOML with the stdlib when available, with a strict small fallback."""

    source = _safe_read(path)
    if source is None:
        return "missing or unsafe TOML file"
    try:
        import tomllib  # Python 3.11+

        tomllib.loads(source)
        return None
    except ImportError:
        section = re.compile(r"^\[[A-Za-z0-9_.-]+\]$")
        assignment = re.compile(r"^[A-Za-z0-9_.-]+\s*=\s*(?:\"[^\"]*\"|'[^']*'|true|false|[0-9]+)$")
        for number, line in enumerate(source.splitlines(), 1):
            stripped = line.split("#", 1)[0].strip()
            if stripped and not section.fullmatch(stripped) and not assignment.fullmatch(stripped):
                return "unsupported or invalid TOML at line {0}".format(number)
        return None
    except Exception as error:
        return str(error)


def _validate_ini(path: Path) -> str | None:
    source = _safe_read(path)
    if source is None:
        return "missing or unsafe INI file"
    parser = configparser.ConfigParser(interpolation=None, strict=True)
    parser.optionxform = str
    try:
        parser.read_string(source)
    except configparser.Error as error:
        return str(error)
    return None


def _validate_layout_javascript(path: Path) -> str | None:
    """Perform a deliberately small structural check without executing JS."""

    source = _safe_read(path)
    if source is None:
        return "missing or unsafe JavaScript file"
    forbidden = ("fetch(", "xmlhttprequest", "require(", "import ", "child_process")
    lowered = source.lower()
    if any(token in lowered for token in forbidden):
        return "layout must not load network or external code"
    stack: list[str] = []
    matching = {")": "(", "]": "[", "}": "{"}
    quote: str | None = None
    escaped = False
    for character in source:
        if quote is not None:
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == quote:
                quote = None
            continue
        if character in {"'", '"'}:
            quote = character
        elif character in "([{":
            stack.append(character)
        elif character in ")]}":
            if not stack or stack.pop() != matching[character]:
                return "unbalanced JavaScript delimiters"
    if quote is not None or stack:
        return "unterminated JavaScript string or delimiter"
    return None


def _validate_svg(path: Path) -> str | None:
    """Check a local vector asset without loading it or resolving references."""

    source = _safe_read(path)
    if source is None:
        return "missing or unsafe SVG file"
    try:
        root = ET.fromstring(source)
    except ET.ParseError as error:
        return str(error)
    if root.tag.rsplit("}", 1)[-1] != "svg":
        return "root element must be svg"
    for element in root.iter():
        if element.tag.rsplit("}", 1)[-1] in {"image", "script", "foreignObject"}:
            return "SVG must not embed raster, script, or foreign content"
        for value in element.attrib.values():
            normalized = value.strip().lower()
            if "http://" in normalized or "https://" in normalized or "file://" in normalized:
                return "SVG must not reference an external resource"
    return None


def _validate_desktop_overlay(root: Path) -> tuple[list[str], list[str]]:
    """Validate the reviewable desktop overlay formats without executing them."""

    overlay = root / "system" / "desktop" / "overlays"
    checks: list[str] = []
    errors: list[str] = []
    toml = overlay / "etc" / "greetd" / "config.toml"
    result = _validate_toml(toml)
    checks.append(toml.relative_to(root).as_posix())
    if result:
        errors.append("{0}: {1}".format(toml.relative_to(root).as_posix(), result))
    for relative in (
        "etc/skel/.config/kdeglobals",
        "etc/skel/.config/kscreenlockerrc",
        "etc/skel/.config/kwinrc",
        "etc/skel/.config/kxkbrc",
        "etc/skel/.config/plasmarc",
        "usr/share/color-schemes/AureonLiquidGlass.colors",
    ):
        candidate = overlay / relative
        result = _validate_ini(candidate)
        checks.append(candidate.relative_to(root).as_posix())
        if result:
            errors.append("{0}: {1}".format(candidate.relative_to(root).as_posix(), result))
    layout = overlay / "usr" / "share" / "plasma" / "look-and-feel" / "org.aureon.desktop" / "contents" / "layouts" / "org.kde.plasma.desktop-layout.js"
    result = _validate_layout_javascript(layout)
    checks.append(layout.relative_to(root).as_posix())
    if result:
        errors.append("{0}: {1}".format(layout.relative_to(root).as_posix(), result))
    for relative in (
        "usr/share/plasma/desktoptheme/AureonLiquidGlass/widgets/panel-background.svg",
        "usr/share/wallpapers/AureonLiquidGlass/contents/images/1920x1080.svg",
    ):
        candidate = overlay / relative
        result = _validate_svg(candidate)
        checks.append(candidate.relative_to(root).as_posix())
        if result:
            errors.append("{0}: {1}".format(candidate.relative_to(root).as_posix(), result))
    try:
        sources = tuple(overlay.rglob("*"))
    except OSError as error:
        errors.append("desktop overlay cannot be enumerated: {0}".format(error))
    else:
        for candidate in sources:
            if candidate.is_symlink():
                errors.append("desktop overlay must not contain a source symlink: {0}".format(candidate.relative_to(root).as_posix()))
    return checks, errors


def _validate_sources() -> dict[str, Any]:
    root = _repo_root()
    if root is None:
        return {
            "state": "partial",
            "reason": "runtime image has no checkout; local source validation is unavailable",
            "checks": {"runtime": "present"},
        }
    relative_json = (
        "packaging/aureon-control-plane.json",
        "packaging/desktop-profile.json",
        "packaging/service-classes.json",
        "packaging/data-classes.json",
        "packaging/driver-policy.json",
        "packaging/game-profile.schema.json",
        "packaging/appearance-profiles.json",
        "packaging/display-profile.json",
        "system/desktop/overlays/usr/share/plasma/look-and-feel/org.aureon.desktop/metadata.json",
        "system/desktop/overlays/usr/share/plasma/desktoptheme/AureonLiquidGlass/metadata.json",
        "system/desktop/overlays/usr/share/wallpapers/AureonLiquidGlass/metadata.json",
    )
    errors: list[str] = []
    for relative in relative_json:
        path = root / relative
        try:
            parsed = json.loads(path.read_text(encoding="utf-8"))
            if not isinstance(parsed, dict):
                errors.append(relative + " must contain a JSON object")
        except (OSError, json.JSONDecodeError) as error:
            errors.append("{0}: {1}".format(relative, error))
    required_docs = (
        "docs/aureon-user-authority.md",
        "docs/policies/privacy.md",
        "docs/policies/data.md",
        "docs/policies/updates.md",
        "docs/policies/drivers.md",
        "docs/reproducibility.md",
        "docs/testing/baseline.md",
        "docs/aureon-phase-map.md",
    )
    for relative in required_docs:
        if not (root / relative).is_file():
            errors.append(relative + " is required by the phase-control contract")
    desktop = root / "system" / "desktop" / "Containerfile"
    if "FROM quay.io/fedora/fedora-bootc@sha256:" not in (desktop.read_text(encoding="utf-8") if desktop.is_file() else ""):
        errors.append("system/desktop/Containerfile must pin the Fedora bootc base by digest")
    greetd = root / "system" / "desktop" / "overlays" / "etc" / "greetd" / "config.toml"
    greetd_source = _safe_read(greetd) or ""
    if "aureon-plasma-session" not in greetd_source or "dbus-run-session" in greetd_source:
        errors.append("greetd must use the reviewed Plasma session wrapper without forcing a nested D-Bus")
    containerignore = root / "system" / "desktop" / ".containerignore"
    ignore_source = _safe_read(containerignore) or ""
    if "**/__pycache__/**" not in ignore_source or "**/*.pyc" not in ignore_source:
        errors.append("system/desktop/.containerignore must exclude generated Python cache files")
    ready_service = root / "system" / "desktop" / "overlays" / "usr" / "lib" / "systemd" / "system" / "aureon-desktop-ready.service"
    ready_source = _safe_read(ready_service) or ""
    if "aureon-wait-desktop-ready" not in ready_source or "ExecStart=/usr/bin/echo" in ready_source:
        errors.append("desktop readiness must wait for the reviewed Plasma session probe")
    session_probe = root / "system" / "desktop" / "overlays" / "usr" / "libexec" / "aureon" / "aureon-session-ready"
    probe_source = _safe_read(session_probe) or ""
    for requirement in ("kwin_wayland", "plasmashell", "org.freedesktop.DBus.Peer.Ping", "1920x1080"):
        if requirement not in probe_source:
            errors.append("desktop session probe is missing requirement: " + requirement)
    plasma_launcher = root / "system" / "desktop" / "overlays" / "usr" / "libexec" / "aureon" / "aureon-plasma-session"
    launcher_source = _safe_read(plasma_launcher) or ""
    for requirement in ("plasma-dbus-run-session-if-needed", "startplasma-wayland"):
        if requirement not in launcher_source:
            errors.append("desktop Plasma launcher is missing requirement: " + requirement)
    readiness_autostart = root / "system" / "desktop" / "overlays" / "etc" / "xdg" / "autostart" / "aureon-session-ready.desktop"
    autostart_source = _safe_read(readiness_autostart) or ""
    if "aureon-session-ready" not in autostart_source or "X-KDE-autostart-phase=2" not in autostart_source:
        errors.append("desktop session readiness must be started by Plasma autostart")
    display_kargs = root / "system" / "desktop" / "overlays" / "usr" / "lib" / "bootc" / "kargs.d" / "20-aureon-desktop-serial.toml"
    if "video=" in (_safe_read(display_kargs) or ""):
        errors.append("desktop kernel arguments must not force a mode rejected by virtual DRM")
    overlay_checks, overlay_errors = _validate_desktop_overlay(root)
    errors.extend(overlay_errors)
    return {
        "state": "passed" if not errors else "failed",
        "errors": errors,
        "checked_files": list(relative_json) + list(required_docs) + [
            containerignore.relative_to(root).as_posix(),
            ready_service.relative_to(root).as_posix(),
            session_probe.relative_to(root).as_posix(),
            plasma_launcher.relative_to(root).as_posix(),
            readiness_autostart.relative_to(root).as_posix(),
            display_kargs.relative_to(root).as_posix(),
        ] + overlay_checks,
    }


def _resource_plan(mode: str) -> dict[str, Any]:
    if mode not in {"stable", "gaming", "streaming", "competitive", "development"}:
        raise ValueError("unknown mode")
    session_classes = {
        "critical": ["input", "audio", "compositor"],
        "interactive": ["foreground-application"],
        "normal": ["background-application"],
        "deferrable": ["indexing", "update-download", "cache-cleanup", "backup"],
    }
    plan: dict[str, Any] = {
        "state": "plan-only",
        "mode": mode,
        "cgroup_mode_detected": _cgroup_mode(),
        "process_classes": session_classes,
        "forbidden_actions": [
            "kill interactive applications",
            "set permanent maximum priority",
            "change voltages or overclock hardware",
        ],
        "restoration": "all temporary preferences expire when the selected session ends",
    }
    if mode in {"gaming", "streaming"}:
        plan["temporary_actions"] = [
            "defer deferrable work",
            "protect audio and compositor responsiveness",
            "reserve I/O planning for the foreground workload",
        ]
    elif mode == "competitive":
        plan["blocked"] = "competitive integrity requires per-game user confirmation and is not implemented"
    else:
        plan["temporary_actions"] = ["no policy is applied"]
    return plan


def _appearance_plan(profile: str) -> dict[str, Any]:
    """Describe a local visual profile without changing the current session."""

    if profile not in APPEARANCE_PROFILES:
        raise ValueError("unknown appearance profile")
    selected = APPEARANCE_PROFILES[profile]
    return {
        "state": "plan-only",
        "profile": profile,
        "theme": "AureonLiquidGlass" if profile != "off" else "system-accessibility-theme",
        "color_scheme": "AureonLiquidGlass" if profile != "off" else "system-accessibility-color-scheme",
        "wallpaper": "AureonLiquidGlass" if profile != "off" else "user-choice",
        "blur": selected["blur"],
        "transparency": selected["transparency"],
        "accessibility": [
            "high contrast remains a user choice",
            "reduce motion remains a user choice",
            "reduce transparency remains a user choice",
        ],
        "does_not": ["download assets", "change host settings", "override a user choice after initial setup"],
        "note": selected["note"],
    }


def _driver_report() -> dict[str, Any]:
    modules = _safe_read(Path("/proc/modules")) or ""
    return {
        "state": "inspection-only",
        "kernel": platform.release(),
        "graphics_stack": {
            "dri_nodes": sorted(item.name for item in Path("/dev/dri").iterdir()) if Path("/dev/dri").is_dir() else [],
            "vulkaninfo": _tool_state("vulkaninfo"),
            "mesa_query": _tool_state("glxinfo"),
        },
        "ntsync": {
            "device": "present" if Path("/dev/ntsync").exists() else "absent",
            "module": "loaded" if re.search(r"^ntsync\s", modules, flags=re.MULTILINE) else "not-loaded",
        },
        "secure_boot": _secure_boot_state(),
        "selinux": _selinux_state(),
        "policy": {
            "automatic_install": "forbidden",
            "automatic_choice": "only installed, signed, unequivocal matches in a future implementation",
            "user_confirmation": ["proprietary driver", "channel change", "downgrade", "restart"],
        },
    }


def _integrity_report() -> dict[str, Any]:
    os_release = _safe_read(Path("/usr/lib/os-release")) or _safe_read(Path("/etc/os-release")) or ""
    is_aureon = any(line.startswith("ID=aureon") for line in os_release.splitlines())
    return {
        "state": "local-basic-diagnostics",
        "data_sent": False,
        "system_identity": "aureon" if is_aureon else "non-aureon-or-development-environment",
        "secure_boot": _secure_boot_state(),
        "selinux": _selinux_state(),
        "ntsync_device": "present" if Path("/dev/ntsync").exists() else "absent",
        "competitive_integrity": "not-implemented",
        "not_observed": [
            "documents", "conversations", "keystrokes", "screenshots", "microphone", "camera", "general process list"
        ],
    }


def _plan_report(kind: str) -> dict[str, Any]:
    plans = {
        "update": {
            "state": "plan-only",
            "workflow": ["check", "download", "validate", "create deployment", "user chooses restart", "confirm or rollback"],
            "network": "disabled by this command",
            "confirmation_required": ["restart", "driver channel change", "firmware update"],
            "forbidden": ["partial in-place mutation", "forced restart"],
        },
        "recovery": {
            "state": "plan-only",
            "workflow": ["preserve evidence", "select known-good deployment", "boot isolated recovery", "user reviews result"],
            "forbidden": ["delete user data", "alter host boot configuration"],
        },
        "installer": {
            "state": "manual-only",
            "target": "none",
            "required_before_any_write": [
                "visual disk selection", "simulation", "explicit partition confirmation", "backup review", "bootloader choice"
            ],
            "forbidden": ["automatic partitioning", "automatic formatting", "changing Windows boot order"],
        },
    }
    return plans[kind]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Aureon local control-plane inspector. All commands are read-only or plan-only.",
    )
    commands = parser.add_subparsers(dest="command", required=True)

    status = commands.add_parser("status", help="show phase implementation states")
    status.add_argument("--phase", type=int, choices=range(33))

    authority = commands.add_parser("authority", help="show authority contract for an action")
    authority.add_argument("action", nargs="?", choices=sorted(ACTIONS))

    commands.add_parser("validate", help="validate local source contracts without writing")
    commands.add_parser("reproducibility", help="inspect local reproducibility controls and remaining gates")
    commands.add_parser("baseline", help="collect a local baseline without storing or exporting it")
    commands.add_parser("overview", help="show a non-identifying local system overview")

    core = commands.add_parser("core", help="verify the minimal Aureon desktop package surface")
    core_sub = core.add_subparsers(dest="core_command", required=True)
    core_sub.add_parser("doctor", help="inspect required and prohibited core packages")

    services = commands.add_parser("services", help="verify session-only services remain dormant")
    services_sub = services.add_subparsers(dest="services_command", required=True)
    services_sub.add_parser("doctor", help="inspect only the declared session-only units")

    hardware = commands.add_parser("hardware", help="local hardware diagnostics")
    hardware_sub = hardware.add_subparsers(dest="hardware_command", required=True)
    hardware_sub.add_parser("doctor", help="inspect local hardware and capabilities")

    driver = commands.add_parser("driver", help="local driver diagnostics")
    driver_sub = driver.add_subparsers(dest="driver_command", required=True)
    driver_sub.add_parser("doctor", help="inspect graphics, kernel and security capabilities")

    resource = commands.add_parser("resource", help="render a no-write resource policy plan")
    resource_sub = resource.add_subparsers(dest="resource_command", required=True)
    resource_plan = resource_sub.add_parser("plan", help="show a temporary cgroup-v2 policy plan")
    resource_plan.add_argument("--mode", default="stable", choices=("stable", "gaming", "streaming", "competitive", "development"))

    appearance = commands.add_parser("appearance", help="render a no-write Liquid Glass appearance plan")
    appearance_sub = appearance.add_subparsers(dest="appearance_command", required=True)
    appearance_plan = appearance_sub.add_parser("plan", help="show a local, reversible appearance profile")
    appearance_plan.add_argument("--profile", default="balanced", choices=tuple(APPEARANCE_PROFILES))

    gaming = commands.add_parser("gaming", help="render a no-write game session plan")
    gaming_sub = gaming.add_subparsers(dest="gaming_command", required=True)
    gaming_plan = gaming_sub.add_parser("plan", help="show the reversible game-session policy")
    gaming_plan.add_argument("--game", default="selected-game")

    streaming = commands.add_parser("streaming", help="render a no-write streaming session plan")
    streaming_sub = streaming.add_subparsers(dest="streaming_command", required=True)
    streaming_plan = streaming_sub.add_parser("plan", help="show the reversible streaming policy")
    streaming_plan.add_argument("--encoder", choices=("auto", "vaapi", "nvenc", "x264"), default="auto")

    integrity = commands.add_parser("integrity", help="local integrity diagnostics")
    integrity_sub = integrity.add_subparsers(dest="integrity_command", required=True)
    integrity_sub.add_parser("doctor", help="inspect only local basic integrity state")

    for name in ("update", "recovery", "installer"):
        command = commands.add_parser(name, help="render a safe {0} plan".format(name))
        sub = command.add_subparsers(dest=name + "_command", required=True)
        sub.add_parser("plan", help="show the no-write {0} workflow".format(name))
    return parser


def main(arguments: list[str] | None = None, output: TextIO | None = None) -> int:
    output = output or sys.stdout
    args = build_parser().parse_args(arguments)
    try:
        if args.command == "status":
            phases = {str(args.phase): PHASE_STATES[args.phase]} if args.phase is not None else {str(key): value for key, value in PHASE_STATES.items()}
            _emit({"command": "status", "phases": phases, "all_actions_are_plan_or_diagnostic_only": True}, output)
        elif args.command == "authority":
            action = {args.action: ACTIONS[args.action]} if args.action else ACTIONS
            _emit({"command": "authority", "actions": action}, output)
        elif args.command == "validate":
            _emit({"command": "validate", "result": _validate_sources()}, output)
        elif args.command == "reproducibility":
            _emit({"command": "reproducibility", "result": _reproducibility_report()}, output)
        elif args.command == "baseline":
            _emit({"command": "baseline", "result": _baseline_report(), "data_sent": False}, output)
        elif args.command == "overview":
            _emit({"command": "overview", "result": _overview_report(), "data_sent": False}, output)
        elif args.command == "core":
            _emit({"command": "core doctor", "result": _core_report()}, output)
        elif args.command == "services":
            _emit({"command": "services doctor", "result": _service_report()}, output)
        elif args.command == "hardware":
            _emit({"command": "hardware doctor", "result": _hardware_report()}, output)
        elif args.command == "driver":
            _emit({"command": "driver doctor", "result": _driver_report()}, output)
        elif args.command == "resource":
            _emit({"command": "resource plan", "result": _resource_plan(args.mode)}, output)
        elif args.command == "appearance":
            _emit({"command": "appearance plan", "result": _appearance_plan(args.profile)}, output)
        elif args.command == "gaming":
            game = _validate_label(args.game, "--game")
            _emit({
                "command": "gaming plan",
                "result": {
                    "state": "plan-only", "game_label": game, "mode": "gaming",
                    "actions": _resource_plan("gaming")["temporary_actions"],
                    "does_not": ["launch a game", "install Proton", "change drivers", "enable overclocking"],
                    "restore_after_session": True,
                },
            }, output)
        elif args.command == "streaming":
            _emit({
                "command": "streaming plan",
                "result": {
                    "state": "plan-only", "mode": "streaming", "encoder_preference": args.encoder,
                    "actions": _resource_plan("streaming")["temporary_actions"],
                    "confirmation_required": ["start broadcast", "select platform/key", "activate camera", "activate microphone"],
                    "does_not": ["open OBS", "record", "stream", "access camera", "access microphone"],
                },
            }, output)
        elif args.command == "integrity":
            _emit({"command": "integrity doctor", "result": _integrity_report()}, output)
        elif args.command in {"update", "recovery", "installer"}:
            _emit({"command": args.command + " plan", "result": _plan_report(args.command)}, output)
        else:
            raise ValueError("unknown command")
    except ValueError as error:
        print("{0}: {1}".format(PROGRAM, error), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

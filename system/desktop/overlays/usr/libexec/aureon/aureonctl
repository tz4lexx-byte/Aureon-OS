def _now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def _emit(payload: dict[str, Any], output: TextIO) -> None:
    payload.setdefault("schema", SCHEMA)
    payload.setdefault("version", VERSION)
    payload.setdefault("generated_at_utc", _now())
    json.dump(payload, output, ensure_ascii=False, indent=2, sort_keys=True)
    output.write("\n")


def _repo_root() -> Path | None:
    """Find the checkout only when this executable runs from it."""

    for candidate in Path(__file__).resolve().parents:
        if (candidate / "packaging" / "aureon-control-plane.json").is_file():
            return candidate
    return None


def _safe_read(path: Path, limit: int = 131_072) -> str | None:
    try:
        if not path.is_file() or path.is_symlink():
            return None
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            return handle.read(limit)
    except OSError:
        return None


def _human_bytes(value: int | None) -> str:
    if value is None or value < 0:
        return "Unavailable"
    unit = "GiB" if value >= 1024**3 else "MiB"
    divisor = 1024**3 if unit == "GiB" else 1024**2
    return "{0:.1f} {1}".format(value / divisor, unit)


def _human_uptime(seconds: float | None) -> str:
    if seconds is None or seconds < 0:
        return "Unavailable"
    minutes = int(seconds) // 60
    hours, minutes = divmod(minutes, 60)
    return "{0}h {1}m".format(hours, minutes) if hours else "{0}m".format(minutes)


def _os_version(release: str | None) -> str:
    if not release:
        return "Unavailable"
    values: dict[str, str] = {}
    for line in release.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key in {"VERSION", "VERSION_ID"}:
            values[key] = value.strip().strip("\"'")
    return values.get("VERSION") or values.get("VERSION_ID") or "Unavailable"


def _overview_report() -> dict[str, Any]:
    """Return a bounded, non-identifying summary from fixed local sources."""

    unavailable = "Unavailable"
    mem_total: int | None = None
    memory = _safe_read(Path("/proc/meminfo"), 16_384)
    if memory:
        match = re.search(r"^MemTotal:\s+(\d+)\s+kB$", memory, re.MULTILINE)
        if match:
            mem_total = int(match.group(1)) * 1024

    uptime: float | None = None
    uptime_text = _safe_read(Path("/proc/uptime"), 256)
    if uptime_text:
        try:
            uptime = float(uptime_text.split()[0])
        except (IndexError, ValueError):
            pass

    storage_total: int | None = None
    storage_available: int | None = None
    try:
        storage = os.statvfs("/")
        storage_total = storage.f_frsize * storage.f_blocks
        storage_available = storage.f_frsize * storage.f_bavail
    except OSError:
        pass

    cpu_count = os.cpu_count()
    values = {
        "system_name": "Aureon OS",
        "system_version": _os_version(_safe_read(Path("/etc/os-release"), 16_384)),
        "kernel_version": platform.release() or unavailable,
        "architecture": platform.machine() or unavailable,
        "logical_cpus": str(cpu_count) if cpu_count is not None and cpu_count > 0 else unavailable,
        "memory_total": _human_bytes(mem_total),
        "storage_total": _human_bytes(storage_total),
        "storage_available": _human_bytes(storage_available),
        "uptime": _human_uptime(uptime),
    }
    available = sum(value != unavailable for value in values.values())
    if available == len(values):
        state = "Healthy"
    elif available > 1:
        state = "Limited data"
    else:
        state = unavailable
    return {
        "state": state,
        "values": values,
        "privacy": "local-only, read-only, non-identifying",
        "writes_performed": False,
    }


def _safe_command(argv: tuple[str, ...], timeout: int = 8) -> dict[str, Any]:
    """Capture a fixed local inspection command without a shell or network."""

    executable = shutil.which(argv[0])
    if not executable:
        return {"state": "unavailable", "command": argv[0]}
    try:
        result = subprocess.run(
            (executable,) + argv[1:],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
            check=False,
            env={"LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return {"state": "unavailable", "command": argv[0], "detail": str(error)}
    return {
        "state": "available" if result.returncode == 0 else "failed",
        "command": argv[0],
        "returncode": result.returncode,
        "stdout": result.stdout[:65_536],
    }


def _tool_state(name: str) -> str:
    return "installed" if shutil.which(name) else "missing"


def _cgroup_mode() -> str:
    try:
        return "v2" if Path("/sys/fs/cgroup/cgroup.controllers").exists() else "other"
    except OSError:
        return "unavailable"


def _secure_boot_state() -> str:
    candidates = tuple(Path("/sys/firmware/efi/efivars").glob("SecureBoot-*"))
    if not candidates:
        return "unavailable"
    try:
        value = candidates[0].read_bytes()
        return "enabled" if value and value[-1] == 1 else "disabled"
    except OSError:
        return "unavailable"


def _selinux_state() -> str:
    result = _safe_command(("getenforce",))
    if result["state"] != "available":
        return "unavailable"
    return str(result["stdout"]).strip().lower() or "unavailable"


def _validate_label(value: str, label: str) -> str:
    if not SAFE_LABEL.fullmatch(value):
        raise ValueError("{0} must be a 1-96 character label, not a path or command".format(label))
    return value



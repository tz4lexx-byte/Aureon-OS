#!/bin/sh
# Apply the default Aureon Carbon appearance once per new profile.
# The system look-and-feel/color scheme is already supplied by /etc/skel.  This
# helper waits for Plasma to be ready, then uses its wallpaper helper or (on
# newer Plasma installations) its DBus API.  Future choices remain entirely in
# the user's control.
set -eu

if [ "$(id -un)" != "aureon" ]; then
    exit 0
fi

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
marker="${config_home}/aureon/carbon-v2-sharp-wallpaper-applied"
wallpaper="/usr/share/wallpapers/AureonCarbon/contents/images/1920x1080.svg"

if [ -e "$marker" ] || [ ! -r "$wallpaper" ]; then
    exit 0
fi

attempt=0
while [ "$attempt" -lt 20 ]; do
    if pgrep -x plasmashell >/dev/null 2>&1; then
        break
    fi
    attempt=$((attempt + 1))
    sleep 1
done

# Applying colors alone does not install the look-and-feel package's desktop
# layout.  This marker is profile-local, so reset the layout exactly once for a
# new Aureon profile and leave all later user customization untouched.
plasma-apply-lookandfeel --apply org.aureon.desktop --resetLayout

applied=false
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    if plasma-apply-wallpaperimage "$wallpaper"; then
        applied=true
    fi
fi

# Plasma can retain its "blurred background" option when a user later selects
# an image.  Seed every desktop with proportional crop and blur disabled.  The
# values remain user-editable after this one-time initialization.
dbus_tool=""
if command -v qdbus6 >/dev/null 2>&1; then
    dbus_tool="qdbus6"
elif command -v qdbus-qt6 >/dev/null 2>&1; then
    dbus_tool="qdbus-qt6"
elif command -v qdbus >/dev/null 2>&1; then
    dbus_tool="qdbus"
fi
plasma_script='var ds=desktops();for(var i=0;i<ds.length;i++){ds[i].wallpaperPlugin="org.kde.image";ds[i].currentConfigGroup=["Wallpaper","org.kde.image","General"];ds[i].writeConfig("Image","file:///usr/share/wallpapers/AureonCarbon/contents/images/1920x1080.svg");ds[i].writeConfig("FillMode",2);ds[i].writeConfig("Blur",false);}'
if [ -n "$dbus_tool" ]; then
    if "$dbus_tool" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$plasma_script"; then
        applied=true
    fi
elif command -v busctl >/dev/null 2>&1; then
    if busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$plasma_script" >/dev/null; then
        applied=true
    fi
fi

if [ "$applied" = true ]; then
    mkdir -p "${config_home}/aureon"
    : > "$marker"
fi

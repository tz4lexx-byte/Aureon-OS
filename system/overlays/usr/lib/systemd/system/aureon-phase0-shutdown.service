[Unit]
Description=Aureon OS Phase 0 clean VM shutdown
Documentation=https://github.com/bootc-dev/bootc
ConditionVirtualization=vm
Requires=aureon-phase0-ready.service
After=aureon-phase0-ready.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --no-block poweroff
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target

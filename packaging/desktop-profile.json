{
  "schema": "aureon.desktop-profile",
  "version": 1,
  "base_image": "quay.io/fedora/fedora-bootc@sha256:86cd97f1e7962e30f52f35ae1c0719299df4f681492b133ea4bcdb74d154fb92",
  "profile": "desktop-preview",
  "base_provided_required": ["kernel", "systemd", "NetworkManager", "bootc"],
  "package_resolution": {
    "lock_required_for_release": true,
    "lock_source": "rpm-query-from-derived-oci",
    "network_permitted_only_during": "explicit-preview-build"
  },
  "core_packages": [
    "greetd",
    "greetd-selinux",
    "dbus-daemon",
    "plasma-desktop",
    "plasma-workspace",
    "plasma-workspace-wayland",
    "kwin-wayland",
    "xdg-desktop-portal-kde",
    "mesa-dri-drivers",
    "pipewire",
    "python3",
    "wireplumber",
    "dolphin",
    "konsole"
  ],
  "diagnostic_packages": [
    "pciutils",
    "usbutils",
    "vulkan-tools"
  ],
  "optional_components": {
    "gaming": ["steam", "wine", "proton", "gamescope"],
    "streaming": ["obs-studio"],
    "development": ["git", "gcc", "python3"],
    "competitive": []
  },
  "prohibited_automatic_components": [
    "proprietary-gpu-driver",
    "anti-cheat",
    "firmware-updater",
    "telemetry-agent"
  ]
}

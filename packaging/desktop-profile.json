{
  "schema": "aureon.desktop-profile",
  "version": 1,
  "base_image": "quay.io/fedora/fedora-bootc@sha256:86cd97f1e7962e30f52f35ae1c0719299df4f681492b133ea4bcdb74d154fb92",
  "profile": "desktop-preview",
  "display_profile": "packaging/display-profile.json",
  "base_provided_required": ["kernel", "systemd", "NetworkManager", "bootc"],
  "package_resolution": {
    "lock_required_for_release": true,
    "lock_source": "rpm-query-from-derived-oci",
    "network_permitted_only_during": "explicit-preview-build"
  },
  "core_packages": [
    "greetd",
    "greetd-selinux",
    "dbus-daemon",
    "plasma-desktop",
    "plasma-workspace",
    "libkscreen",
    "xdg-desktop-portal-kde",
    "plasma-discover",
    "plasma-discover-flatpak",
    "plasma-systemmonitor",
    "flatpak",
    "NetworkManager-wifi",
    "bluez",
    "bluez-tools",
    "rfkill",
    "powerdevil",
    "tuned-ppd",
    "brightnessctl",
    "libinput-utils",
    "v4l-utils",
    "alsa-utils",
    "iio-sensor-proxy",
    "switcheroo-control",
    "mesa-dri-drivers",
    "mesa-vulkan-drivers",
    "mesa-va-drivers",
    "vulkan-loader",
    "pipewire",
    "pipewire-alsa",
    "pipewire-pulseaudio",
    "python3",
    "wireplumber",
    "dolphin",
    "konsole",
    "firefox",
    "libreoffice",
    "ffmpeg-free",
    "ark",
    "kate",
    "spectacle"
  ],
  "diagnostic_packages": [
    "pciutils",
    "usbutils",
    "vulkan-tools"
  ],
  "optional_components": {
    "gaming": ["steam", "proton", "wine", "gamescope", "mangohud", "goverlay", "heroic"],
    "streaming": ["obs-studio", "kdenlive"],
    "development": ["git", "gcc", "python3"],
    "competitive": []
  },
  "preinstalled_flatpaks": [
    {
      "app_id": "com.valvesoftware.Steam",
      "remote": "flathub",
      "channel": "stable",
      "maintainer": "community",
      "verified_by_vendor": false
    },
    {
      "app_id": "com.obsproject.Studio",
      "remote": "flathub",
      "channel": "stable",
      "maintainer": "OBS Project",
      "verified_by_vendor": true
    }
  ],
  "gaming_device_rules": {
    "source": "https://github.com/ValveSoftware/steam-devices",
    "commit": "22ec85e5ff5ea2e15c56d71a41bcbef46356cd60",
    "license": "MIT",
    "files": [
      "60-steam-input.rules",
      "60-steam-vr.rules"
    ]
  },
  "prohibited_automatic_components": [
    "proprietary-gpu-driver",
    "anti-cheat",
    "firmware-updater",
    "telemetry-agent"
  ],
  "runtime_validation": [
    "aureonctl baseline",
    "aureonctl core doctor",
    "aureonctl services doctor"
  ]
}
